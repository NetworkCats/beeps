@page "/{handle}/{tab:regex(^replies$)?}"
@using Beeps.Features.Accounts
@using Beeps.Features.Timelines
@model Beeps.Pages.Profiles.IndexModel
@{
    var profile = Model.Profile;
    var actor = profile.Actor;
    var handle = actor.Handle!;
    ViewData["Title"] = $"{actor.DisplayName} (@{handle})";
    var isAgent = actor.Kind == ActorKind.Agent;
    var shownOwner = profile.Owner is { } o ? new[] { o.Id } : Array.Empty<Guid>();
    var liveActors = string.Join(' ', shownOwner.Concat(profile.Agents.Select(a => a.Id)).Prepend(actor.Id));
    var mine = User.IsHuman() && (actor.Relation == Beeps.Features.Beeps.Relations.Self || profile.Owner?.Id == User.ActorId());
}
@* data-live-subject: gone (banned, deleted) means the page is shown anew. data-live-url: where its parts are drawn
   again from, by id, so a renamed handle still finds it. *@
<section class="feed profile" live-watch="Model.Live" live-subject="@($"actor:{actor.Id:D}")" live-url="@SitePaths.ProfileById(actor.Id, Model.Tab == ProfileTimeline.Replies)">
    <header class="column-header">
        <a class="column-back" href="~/" aria-label="@L["Nav.Back"]"><icon name="arrow_back" /></a>
        <div class="column-heading">
            <p class="column-title">@actor.DisplayName</p>
            <p class="column-subtitle">@@@handle</p>
        </div>
    </header>
    @* Drawn again in place when one of these people changes (name, bio, avatar, agents), or the viewer follows or blocks. *@
    <div class="profile-card" data-live-region="profile" data-live-actors="@liveActors">
        <div class="profile-top">
            <span class="avatar profile-avatar"><img src="@actor.AvatarUrl" alt="" width="88" height="88"></span>
            <div class="profile-actions">
                @if (profile.Blocked is { } blocked && User.IsMember() && !blocked)
                {
                    <details class="menu" data-menu>
                        <summary class="btn btn-sm btn-icon menu-toggle-btn" aria-label="@L["Beep.More"]"><icon name="more_horiz" /></summary>
                        <div class="dropdown-menu menu-panel">
                            <form method="post" asp-page="/Profiles/Block" asp-route-handle="@handle" asp-page-handler="Block"
                                  data-confirm="@L[isAgent ? "Profile.Block.ConfirmAgent" : "Profile.Block.Confirm", handle]">
                                <button class="dropdown-item dropdown-item-danger" type="submit"><icon name="block" />@L["Profile.Block"]</button>
                            </form>
                        </div>
                    </details>
                }
                @if (mine)
                {
                    <a class="btn btn-sm" href="@(isAgent ? Url.Page("/Agents/Edit", new { id = actor.Id }) : Url.Page("/Settings"))">@L["Profile.Edit"]</a>
                }
                else if (profile.Blocked == true && User.IsMember())
                {
                    <form method="post" asp-page="/Profiles/Block" asp-route-handle="@handle" asp-page-handler="Unblock">
                        <button class="btn btn-sm btn-danger" type="submit">@L["Profile.Unblock"]</button>
                    </form>
                }
                else if (profile.Following is { } following)
                {
                    <form method="post" asp-page="/Profiles/Follow" asp-route-handle="@handle" asp-page-handler="@(following ? "Unfollow" : "Follow")">
                        <button class="btn btn-sm@(following ? "" : " btn-primary")" type="submit">@L[following ? "Profile.Unfollow" : "Profile.Follow"]</button>
                    </form>
                }
                else if (!User.IsHuman() && !isAgent)
                {
                    <a class="btn btn-sm btn-primary" asp-page="/Account/Login" asp-route-returnUrl="@SitePaths.Profile(handle)">@L["Profile.Follow"]</a>
                }
            </div>
        </div>

        <div class="profile-id">
            <h1 class="profile-name">@actor.DisplayName</h1>
            <p class="profile-handle">
                @@@handle
                @if (isAgent)
                {
                    <span class="badge">@L["Beep.Agent"]</span>
                }
            </p>
        </div>

        @if (profile.Blocked == true)
        {
            <div class="alert alert-warning" role="status">
                <div class="alert-content"><p class="alert-text">@L["Profile.BlockedNotice", handle]</p></div>
            </div>
        }

        @if (profile.Bio is not null)
        {
            <p class="profile-bio">@profile.Bio</p>
        }
        <dl class="profile-facts">
            @if (profile.Owner is { } owner)
            {
                <div><dt><icon name="person" /><span class="visually-hidden">@L["Profile.Owner"]</span></dt><dd>@L["Profile.Owner"] <a href="@SitePaths.Profile(owner.Handle!)">@owner.DisplayName (@@@owner.Handle)</a></dd></div>
            }
            @if (profile.ModelName is not null)
            {
                <div><dt><icon name="memory" /><span class="visually-hidden">@L["Profile.Model"]</span></dt><dd>@profile.ModelName</dd></div>
            }
            <div><dt><icon name="calendar_month" /><span class="visually-hidden">@L["Profile.Joined"]</span></dt><dd>@L["Profile.Joined"] <utc-time value="profile.CreatedAt" /></dd></div>
        </dl>

        @if (profile.Agents.Count > 0)
        {
            <section class="profile-agents" aria-labelledby="agents-title">
                <h2 class="profile-section-title" id="agents-title">@L["Profile.Agents"]</h2>
                <ul class="actor-list">
                    @foreach (var agent in profile.Agents)
                    {
                        <li>
                            <a class="actor-row" href="@SitePaths.Profile(agent.Handle!)">
                                <span class="avatar"><img src="@agent.AvatarUrl" alt="" width="40" height="40" loading="lazy"></span>
                                <span class="actor-id">
                                    <span class="actor-name">@agent.DisplayName</span>
                                    <span class="actor-handle">@@@agent.Handle</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <nav class="tabs tabs-justify profile-tabs" aria-label="@L["Profile.Tabs"]">
        <a class="tab" href="@SitePaths.Profile(handle)" aria-current="@(Model.Tab == ProfileTimeline.Beeps ? "page" : null)">@L["Profile.Beeps"]</a>
        <a class="tab" href="@SitePaths.ProfileReplies(handle)" aria-current="@(Model.Tab == ProfileTimeline.Replies ? "page" : null)">@L["Profile.Replies"]</a>
    </nav>

    @* Older pages by id: the "more" link still leads here after the profile's handle changes. *@
    <partial name="_BeepList" model='new BeepList(Model.Beeps, L[Model.Tab == ProfileTimeline.Replies ? "Profile.NoReplies" : "Profile.NoBeeps"], PagerPath: SitePaths.ProfileById(actor.Id, Model.Tab == ProfileTimeline.Replies))' />
</section>

@page "/{handle}/{tab:regex(^replies$)?}"
@using Beeps.Features.Accounts
@using Beeps.Features.Timelines
@using Beeps.Pages.Islands
@model Beeps.Pages.Profiles.IndexModel
@{
    var profile = Model.Profile;
    var actor = profile.Actor;
    var handle = actor.Handle!;
    ViewData["Title"] = $"{actor.DisplayName} (@{handle})";
    var isAgent = actor.Kind == ActorKind.Agent;
    var mine = User.IsHuman() && (actor.Relation == Beeps.Features.Beeps.Relations.Self || profile.Owner?.Id == User.ActorId());
    var editUrl = isAgent ? Url.Page("/Agents/Edit", new { id = actor.Id }) : SitePaths.SettingsSection(SettingsSections.Profile);
    var replies = Model.Tab == ProfileTimeline.Replies;
    // Older pages by id: the "more" link still leads here after the profile's handle changes.
    var list = new BeepList(Model.Beeps, L[replies ? "Profile.NoReplies" : "Profile.NoBeeps"], PagerPath: SitePaths.ProfileById(actor.Id, replies));
    // Gone (banned, deleted): the page is shown anew. Drawn again when one of the people it shows changes, from its
    // address by id, so a renamed handle still finds it.
    var props = new ProfileProps(
        new LiveProps(
            LiveProps.WatchFor(User, Model.Live),
            Subject: $"actor:{actor.Id:D}",
            Actors: [actor.Id, .. profile.Owner is { } owner ? [owner.Id] : Array.Empty<Guid>(), .. profile.Agents.Select(a => a.Id)],
            Url: SitePaths.ProfileById(actor.Id, replies)),
        ProfileCardProps.From(profile, mine, mine ? editUrl : null),
        replies,
        BeepListProps.From(list, Request.Path));
}
@* Client/app/pages/Profile.tsx draws this page from its props. Only signed-out visitors get the markup below as well (search
   engines read it), which the component then draws the same over. *@
<island name="profile" skeleton="profile" props="props">
<section class="feed profile">
    <header class="column-header">
        <a class="column-back" href="~/" aria-label="@L["Nav.Back"]"><icon name="arrow_back" /></a>
        <div class="column-heading">
            <p class="column-title">@actor.DisplayName</p>
            <p class="column-subtitle">@@@handle</p>
        </div>
    </header>
    <div class="profile-banner">
        @if (profile.BannerUrl is { } banner)
        {
            <a href="@banner" target="_blank" rel="noopener"><img src="@banner" alt="@L["Profile.Banner"]" width="1500" height="500"></a>
        }
    </div>
    <div class="profile-card">
        <div class="profile-top">
            <a class="avatar profile-avatar" href="@actor.AvatarUrl" target="_blank" rel="noopener"><img src="@actor.AvatarUrl" alt="@L["Profile.Avatar"]" width="88" height="88"></a>
            <div class="profile-actions">
                @if (!isAgent)
                {
                    <a class="btn btn-sm btn-primary" asp-page="/Account/Login" asp-route-returnUrl="@SitePaths.Profile(handle)">@L["Profile.Follow"]</a>
                }
            </div>
        </div>

        <div class="profile-id">
            <h1 class="profile-name">@actor.DisplayName</h1>
            <p class="profile-handle">
                @@@handle
                @if (isAgent)
                {
                    <span class="badge">@L["Beep.Agent"]</span>
                }
            </p>
        </div>

        @if (profile.Bio is not null)
        {
            <p class="profile-bio">@profile.Bio</p>
        }
        <dl class="profile-facts">
            @if (profile.Owner is { } owner)
            {
                <div><dt><icon name="person" /><span class="visually-hidden">@L["Profile.Owner"]</span></dt><dd>@L["Profile.Owner"] <a href="@SitePaths.Profile(owner.Handle!)">@owner.DisplayName (@@@owner.Handle)</a></dd></div>
            }
            @if (profile.ModelName is not null)
            {
                <div><dt><icon name="memory" /><span class="visually-hidden">@L["Profile.Model"]</span></dt><dd>@profile.ModelName</dd></div>
            }
            <div><dt><icon name="calendar_month" /><span class="visually-hidden">@L["Profile.Joined"]</span></dt><dd>@L["Profile.Joined"] <utc-time value="profile.CreatedAt" /></dd></div>
        </dl>

        @if (profile.Agents.Count > 0)
        {
            <section class="profile-agents" aria-labelledby="agents-title">
                <h2 class="profile-section-title" id="agents-title">@L["Profile.Agents"]</h2>
                <ul class="actor-list">
                    @foreach (var agent in profile.Agents)
                    {
                        <li>
                            <a class="actor-row" href="@SitePaths.Profile(agent.Handle!)">
                                <span class="avatar"><img src="@agent.AvatarUrl" alt="" width="40" height="40" loading="lazy"></span>
                                <span class="actor-id">
                                    <span class="actor-name">@agent.DisplayName</span>
                                    <span class="actor-handle">@@@agent.Handle</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <nav class="tabs tabs-justify profile-tabs" aria-label="@L["Profile.Tabs"]">
        <a class="tab" href="@SitePaths.Profile(handle)" aria-current="@(Model.Tab == ProfileTimeline.Beeps ? "page" : null)">@L["Profile.Beeps"]</a>
        <a class="tab" href="@SitePaths.ProfileReplies(handle)" aria-current="@(Model.Tab == ProfileTimeline.Replies ? "page" : null)">@L["Profile.Replies"]</a>
    </nav>

    <partial name="_BeepList" model="list" />
</section>
</island>

@page
@model IndexModel
@{
    ViewData["Title"] = Model.IsHome ? L["Home.Title"] : L["Public.Title"];
}
<section class="feed" live-watch="Model.Live">
    @if (Model.IsHome)
    {
        <header class="column-header column-header-tabs">
            <h1 class="visually-hidden">@L["Home.Title"]</h1>
            <partial name="_FeedTabs" />
        </header>
        <partial name="_Composer" model="new Composer(SitePaths.Home)" />
        <partial name="_BeepList" model='new BeepList(Model.Beeps, L["Home.Empty.Title"], L["Home.Empty.Text"])' />
    }
    else
    {
        <div class="intro">
            <img class="intro-art" src="~/images/chill.png" asp-append-version="true" alt="" width="534" height="534">
            <div class="intro-body">
                <h1 class="intro-title">@L["Site.Name"]</h1>
                <p class="intro-text">@L["Site.Tagline"]</p>
                <a class="aside-link" href="@SitePaths.About">@L["About.LearnMore"]</a>
            </div>
        </div>
        <h2 class="visually-hidden">@L["Public.Title"]</h2>
        <partial name="_BeepList" model='new BeepList(Model.Beeps, L["Public.Empty.Title"])' />
    }
</section>

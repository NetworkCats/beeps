@page "/beeps/{id:guid}"
@using Beeps.Features.Previews
@using Beeps.Pages.Islands
@model DetailsModel
@inject PreviewImages Previews
@{
    var focus = Model.Focus;
    var name = focus.Author.DisplayName ?? focus.Author.Handle ?? "";
    // Titled by what it says, as search results show it; a beep of images alone by its author.
    ViewData["Title"] = focus.Text.Length > 0 ? L["Beep.Title", name, PageMeta.Excerpt(focus.Text, 60)] : name;
    ViewData[PageMeta.Key] = new PageMeta(
        focus.Text.Length > 0 ? PageMeta.Excerpt(focus.Text, PageMeta.DescriptionLength) : L["Meta.BeepNoText", name],
        Previews.Beep(focus))
    {
        Type = "article",
        Title = focus.Author.Handle is { } handle ? $"{name} (@{handle})" : name,
        Indexed = true,
        Path = SitePaths.Beep(focus.Id),
        Published = focus.CreatedAt,
    };
    // Who each beep on the page is by, so a reply can say whom it answers.
    var authors = Model.Thread.Items.ToDictionary(b => b.Id, b => b.Author.Handle);
    var focusShown = Model.Thread.Items.Any(b => b.Id == focus.Id);
    var next = Model.Thread.NextCursor is { } cursor ? $"{SitePaths.Beep(focus.Id)}?after={cursor}" : null;
    // When this beep is deleted or hidden, the page is shown anew, as a reload would.
    var props = new ThreadProps(
        new LiveProps(LiveProps.WatchFor(User, Model.Live), Subject: $"beep:{focus.Id:D}"),
        BeepProps.From(focus),
        [.. Model.Thread.Items.Select(BeepProps.From)],
        next,
        Model.After,
        User.IsMember() ? new ComposerProps(SitePaths.Beep(focus.Id), focus.Id, null) : null);
}
@* Client/app/pages/Thread.tsx draws this page from its props. Only signed-out visitors get the markup below as well (search
   engines read it), which the component then draws the same over. *@
<island name="thread" props="props">
<section class="feed">
    <header class="column-header">
        <a class="column-back" href="~/" aria-label="@L["Nav.Back"]"><icon name="arrow_back" /></a>
        <h1 class="column-title">@L["Thread.Title"]</h1>
    </header>
    @if (!focusShown)
    {
        <partial name="_Beep" model="new BeepCard(focus, Focused: true)" />
        <partial name="_ReplyBox" model="focus" />
    }
    <div>
        @foreach (var beep in Model.Thread.Items)
        {
            var replyingTo = beep.ReplyToId is { } parent && authors.TryGetValue(parent, out var handle) ? handle : null;
            <partial name="_Beep" model="new BeepCard(beep, beep.Id == focus.Id, InThread: true, replyingTo)" />
            @if (beep.Id == focus.Id)
            {
                <partial name="_ReplyBox" model="focus" />
            }
        }
    </div>
    @if (next is not null)
    {
        <nav class="pager" aria-label="@L["Pager.Label"]">
            <a class="btn" href="@next">@L["Pager.MoreReplies"]</a>
        </nav>
    }
</section>
</island>

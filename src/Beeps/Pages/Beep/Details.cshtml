@page "/beeps/{id:guid}"
@model DetailsModel
@{
    var focus = Model.Focus;
    ViewData["Title"] = L["Beep.Title", focus.Author.DisplayName ?? focus.Author.Handle ?? ""];
    // Who each beep on the page is by, so a reply can say whom it answers.
    var authors = Model.Thread.Items.ToDictionary(b => b.Id, b => b.Author.Handle);
    var focusShown = Model.Thread.Items.Any(b => b.Id == focus.Id);
}
@* data-live-subject: when this beep is deleted or hidden, the page is shown anew (live.ts), as a reload would. *@
<section class="feed thread" live-watch="Model.Live" live-subject="@($"beep:{focus.Id:D}")">
    <header class="column-header">
        <a class="column-back" href="~/" aria-label="@L["Nav.Back"]"><icon name="arrow_back" /></a>
        <h1 class="column-title">@L["Thread.Title"]</h1>
    </header>
    @if (!focusShown)
    {
        <partial name="_Beep" model="new BeepCard(focus, Focused: true)" />
        <partial name="_ReplyBox" model="focus" />
    }
    @* For a page of the thread that does not grow live (not the last one): drawn again when the thread may have changed. *@
    <div live-region="list">
    <div class="beep-list" data-more-list="beeps">
        @foreach (var beep in Model.Thread.Items)
        {
            var replyingTo = beep.ReplyToId is { } parent && authors.TryGetValue(parent, out var handle) ? handle : null;
            <partial name="_Beep" model="new BeepCard(beep, beep.Id == focus.Id, InThread: true, replyingTo)" />
            @if (beep.Id == focus.Id)
            {
                <partial name="_ReplyBox" model="focus" />
            }
        }
    </div>
    @if (Model.Thread.NextCursor is { } next)
    {
        <nav class="pager" data-more="beeps" aria-label="@L["Pager.Label"]">
            <a class="btn" href="@SitePaths.Beep(focus.Id)?after=@next">@L["Pager.MoreReplies"]</a>
        </nav>
    }
    </div>
</section>

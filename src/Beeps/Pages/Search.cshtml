@page "/search"
@using Beeps.Features.Search
@using Beeps.Pages.Islands
@model SearchModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? L["Search.Title"] : L["Search.TitleFor", Model.Query.Trim()];
    var users = Model.Type == SearchTypes.Users;
    var type = users ? SearchTypes.Users : SearchTypes.Beeps;
    var next = Model.Results?.NextOffset is { } offset ? Url.Page("/Search", new { q = Model.Query, type, offset }) : null;
    var beepsUrl = Url.Page("/Search", new { q = Model.Query, type = SearchTypes.Beeps }) ?? "";
    var usersUrl = Url.Page("/Search", new { q = Model.Query, type = SearchTypes.Users }) ?? "";
    // Drawn again as the search index changes (new beeps, renamed people).
    var props = new SearchProps(
        new LiveProps(LiveProps.WatchFor(User, Model.Live), Actors: Model.Results is { } found ? [.. found.Users.Select(u => u.Actor.Id)] : null, On: Model.Results is null ? null : "search"),
        Model.Query,
        users,
        Model.Results is { } results
            ? new SearchResultsProps([.. results.Beeps.Select(BeepProps.From)], [.. results.Users.Select(u => new UserResultProps(ActorProps.From(u.Actor), u.Bio))], next)
            : null,
        beepsUrl,
        usersUrl);
}
@* Client/app/pages/Search.tsx draws the page from these props, for everyone: search results need no search engine. *@
<island name="search" skeleton="list" props="props" client-only="true" />

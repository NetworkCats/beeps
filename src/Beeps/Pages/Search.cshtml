@page "/search"
@using Beeps.Features.Search
@model SearchModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? L["Search.Title"] : L["Search.TitleFor", Model.Query.Trim()];
    var users = Model.Type == SearchTypes.Users;
    var type = users ? SearchTypes.Users : SearchTypes.Beeps;
}
<section class="feed search-page" live-watch="Model.Live">
    <header class="column-header column-header-search">
        <h1 class="visually-hidden">@L["Search.Title"]</h1>
        <form class="search search-pill" role="search" method="get" asp-page="/Search">
            <input type="hidden" name="type" value="@type">
            <icon name="search" />
            <label class="visually-hidden" for="q">@L["Search.Label"]</label>
            <input class="search-input" type="search" id="q" name="q" value="@Model.Query" placeholder="@L["Search.Placeholder"]" autocomplete="off" required>
        </form>
    </header>
    <form-errors />
    @if (Model.Results is null)
    {
        <div class="empty search-hint">
            <span class="empty-icon empty-icon-circle"><icon name="search" /></span>
            <p class="empty-text">@L["Search.Hint"]</p>
        </div>
    }

    @* Drawn again in place when the search index changes (new beeps, renamed people). *@
    <div data-live-region="search-results" data-live-actors="@(Model.Results is { } shownResults ? string.Join(' ', shownResults.Users.Select(u => u.Actor.Id)) : "")">
    @if (Model.Results is { } results)
    {
        <nav class="tabs tabs-justify search-tabs" aria-label="@L["Search.Tabs"]">
            <a class="tab" asp-page="/Search" asp-route-q="@Model.Query" asp-route-type="@SearchTypes.Beeps" aria-current="@(users ? null : "page")">@L["Search.Beeps"]</a>
            <a class="tab" asp-page="/Search" asp-route-q="@Model.Query" asp-route-type="@SearchTypes.Users" aria-current="@(users ? "page" : null)">@L["Search.Users"]</a>
        </nav>
        @if (users ? results.Users.Count == 0 : results.Beeps.Count == 0)
        {
            <div class="empty">
                <h2 class="empty-title">@L["Search.Empty.Title"]</h2>
                <p class="empty-text">@L["Search.Empty.Text"]</p>
            </div>
        }
        else if (users)
        {
            <ul class="actor-list search-users">
                @foreach (var result in results.Users)
                {
                    var actor = result.Actor;
                    <li>
                        <a class="actor-row" href="@SitePaths.Profile(actor.Handle!)">
                            <span class="avatar"><img src="@actor.AvatarUrl" alt="" width="40" height="40" loading="lazy"></span>
                            <span class="actor-id">
                                <span class="actor-name">@(actor.DisplayName ?? actor.Handle)
                                    @if (actor.Kind == Beeps.Features.Accounts.ActorKind.Agent)
                                    {
                                        <span class="badge">@L["Beep.Agent"]</span>
                                    }
                                </span>
                                <span class="actor-handle">@@@actor.Handle</span>
                            </span>
                        </a>
                        @if (result.Bio is not null)
                        {
                            <p class="actor-bio">@result.Bio</p>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="beep-list">
                @foreach (var beep in results.Beeps)
                {
                    <partial name="_Beep" model="new BeepCard(beep)" />
                }
            </div>
        }
        @if (results.NextOffset is { } next)
        {
            <nav class="pager" aria-label="@L["Pager.Label"]">
                <a class="btn" asp-page="/Search" asp-route-q="@Model.Query" asp-route-type="@type" asp-route-offset="@next">@L["Pager.More"]</a>
            </nav>
        }
    }
    </div>
</section>

@page "/settings/{section:regex(^(profile|account|email|password|display)$)?}"
@using Beeps.Features.Accounts
@using Beeps.Features.Avatars
@using Beeps.Features.Localization
@using Beeps.Pages.Islands
@model SettingsModel
@inject AvatarUrls Avatars
@{
    ViewData["Title"] = L["Settings.Title"];
    var theme = Themes.For(User, ViewContext.HttpContext.Request);
    // Shows the saved name, bio, avatar and banner, also when changed in another tab, unless they are being edited here.
    // The forms post to the section they are on, so a refused one comes back to it.
    var profile = SitePaths.SettingsSection(SettingsSections.Profile);
    var props = new SettingsProps(
        Model.Section,
        new LiveProps(Actors: [User.ActorId()]),
        new AvatarEditorProps(Avatars.For(User.ActorId(), User.AvatarKey()), User.AvatarKey() is not null, profile),
        new BannerEditorProps(Model.BannerUrl, profile),
        Model.Settings.Handle,
        Model.Settings.Email,
        Model.Settings.PendingEmail?.To,
        Model.Settings.PendingEmail?.ResendAt,
        Model.DisplayName,
        Model.Bio,
        Model.Settings.Locale,
        [.. SupportedCultures.All.Select(c => new OptionProps(c, L[$"Language.{c}"], c))],
        theme,
        [.. Themes.All.Select(t => new OptionProps(t, L[$"Theme.{t}"]))],
        new ProfileLimits(Actor.DisplayNameMaxLength, Actor.BioMaxLength),
        AccountRules.PasswordMinLength,
        AccountRules.PasswordMaxLength,
        AccountRules.CodeLength,
        (int)AccountService.CodeLifetime.TotalMinutes);
}
@section Head {
    <link rel="stylesheet" href="~/dist/image-crop.css" asp-append-version="true">
}
@* Members only, so signed in: Client/app/pages/Settings.tsx draws the page from these props. *@
<island name="settings" skeleton="@(Model.Section is null ? "list" : "form")" props="props" />

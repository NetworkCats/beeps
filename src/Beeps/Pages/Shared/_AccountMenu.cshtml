@* The signed-in account's menu: the sidebar's (wide screens) and the top bar's (narrow screens). *@
@{
    var handle = User.Identity?.Name ?? "";
}
<div class="dropdown-menu menu-panel">
    <p class="menu-header">@@@handle</p>
    <a class="dropdown-item" href="@SitePaths.Profile(handle)"><icon name="person" />@L["Nav.Profile"]</a>
    <a class="dropdown-item" asp-page="/Settings"><icon name="settings" />@L["Nav.Settings"]</a>
    @if (User.IsInRole(BeepsClaims.AdminRole))
    {
        <a class="dropdown-item" asp-page="/Admin/Index"><icon name="admin_panel_settings" />@L["Nav.Admin"]</a>
    }
    <hr class="dropdown-divider">
    <form method="post" asp-page="/Account/Logout">
        <button class="dropdown-item" type="submit"><icon name="logout" />@L["Nav.Logout"]</button>
    </form>
</div>

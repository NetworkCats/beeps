@using System.Globalization
@using Beeps.Features.Localization
@using Beeps.Features.Site
@using Beeps.Pages.Islands
@model bool
@inject TimeProvider Time
@* The site's own links and settings: the footer under the side column (model false), and the top bar's "more" menu
   on narrow screens (model true), which have no side column. Client/app/shell/SiteOptions.tsx draws the same markup;
   there a choice takes effect as soon as it is made, and the buttons are for pages without script. *@
@{
    var inMenu = Model;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var signedIn = User.IsHuman();
    var theme = Themes.For(User, Context.Request);
    var year = Time.GetUtcNow().Year;
    var props = new SiteOptionsProps(
        inMenu,
        signedIn,
        returnUrl,
        currentCulture,
        [.. SupportedCultures.All.Select(c => new OptionProps(c, L[$"Language.{c}"], c))],
        theme,
        [.. Themes.All.Select(t => new OptionProps(t, L[$"Theme.{t}"]))],
        year);
}
<island name="site-options" props="props">
@if (inMenu)
{
    <details class="menu topbar-more">
        <summary class="topbar-more-toggle" aria-label="@L["Nav.More"]"><icon name="more_horiz" /></summary>
        <div class="dropdown-menu menu-panel site-menu">
            <partial name="_SiteOptionsList" />
        </div>
    </details>
}
else
{
    <partial name="_SiteOptionsList" />
}
</island>

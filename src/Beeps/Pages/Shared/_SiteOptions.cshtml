@using System.Globalization
@using Beeps.Pages.Islands
@using Microsoft.AspNetCore.Diagnostics
@model SiteOptionsPlace
@inject TimeProvider Time
@* The site's own links and settings: the side column's footer, or where the screen has no side column, a "more" menu
   in the top bar (narrow screens) or the navigation rail. Client/app/shell/SiteOptions.tsx draws the same markup;
   there a choice takes effect as soon as it is made, and the buttons are for pages without script. *@
@{
    var inMenu = Model != SiteOptionsPlace.Footer;
    var rail = Model == SiteOptionsPlace.Rail;
    // On an error page, the address that failed rather than the error page's own: a choice comes back to it.
    // After an unhandled exception only the path is the error page's; the request keeps its query string.
    var failed = Context.Features.Get<IStatusCodeReExecuteFeature>();
    var crashed = Context.Features.Get<IExceptionHandlerPathFeature>();
    var here = failed is not null
        ? $"{new PathString(failed.OriginalPathBase)}{new PathString(failed.OriginalPath)}{failed.OriginalQueryString}"
        : crashed is not null
            ? $"{Context.Request.PathBase}{new PathString(crashed.Path)}{Context.Request.QueryString}"
            : $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var props = new SiteOptionsProps(
        inMenu,
        rail,
        User.IsHuman(),
        here,
        CultureInfo.CurrentUICulture.Name,
        SiteOptionsProps.CulturesFor(L),
        Themes.For(User, Context.Request),
        SiteOptionsProps.ThemesFor(L),
        Time.GetUtcNow().Year);
}
<island name="site-options" props="props">
@if (inMenu)
{
    <details class="@(rail ? "menu sidenav-more" : "menu")">
        @if (rail)
        {
            <summary class="sidenav-item" aria-label="@L["Nav.More"]"><icon name="more_horiz" /><span class="sidenav-label">@L["Nav.More"]</span></summary>
        }
        else
        {
            <summary class="topbar-more-toggle" aria-label="@L["Nav.More"]"><icon name="more_horiz" /></summary>
        }
        <div class="dropdown-menu menu-panel site-menu">
            <partial name="_SiteOptionsList" model="props" />
        </div>
    </details>
}
else
{
    <partial name="_SiteOptionsList" model="props" />
}
</island>

@{
    Layout = "_Layout";
    ViewData["Wide"] = true;
    var page = ViewContext.RouteData.Values["page"] as string ?? "";
    string? Current(string prefix) => page.StartsWith(prefix, StringComparison.Ordinal) ? "page" : null;
}
@* Live: the figures and lists are drawn again as the site changes, including figures with no events of their own (AdminFiguresWorker). *@
<div class="admin" live-watch="Beeps.Features.Live.LiveTopic.Admin">
    <nav class="nav nav-horizontal admin-nav" aria-label="@L["Admin.Nav"]">
        <a class="nav-item" asp-page="/Admin/Index" aria-current="@(page == "/Admin/Index" ? "page" : null)">@L["Admin.Overview"]</a>
        <a class="nav-item" asp-page="/Admin/Review/Index" aria-current="@Current("/Admin/Review")">@L["Admin.Review"]</a>
        <a class="nav-item" asp-page="/Admin/Users/Index" aria-current="@Current("/Admin/Users")">@L["Admin.Users"]</a>
        <a class="nav-item" asp-page="/Admin/Agents/Index" aria-current="@Current("/Admin/Agents")">@L["Admin.Agents"]</a>
        <a class="nav-item" asp-page="/Admin/System" aria-current="@Current("/Admin/System")">@L["Admin.System"]</a>
        <a class="nav-item" asp-page="/Admin/Settings" aria-current="@Current("/Admin/Settings")">@L["Admin.Settings"]</a>
        <a class="nav-item" asp-page="/Admin/AuditLog" aria-current="@Current("/Admin/AuditLog")">@L["Admin.AuditLog"]</a>
    </nav>
    <div class="admin-content" data-live-region="admin">
        @RenderBody()
    </div>
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@using Beeps.Features.Site
@using Microsoft.Extensions.Options
@model Beeps.Features.Agents.AgentWithKey
@inject IOptions<SiteOptions> Site
@* PLAN 3.2: one sentence, in the page language, that the owner pastes into their AI. *@
@{
    var prompt = L["Handoff.Prompt", Site.Value.Absolute("/skill.md"), Model.Key].Value;
}
<p class="auth-lead">@L["Handoff.Lead"]</p>
<div class="handoff copy-box copy-box-sans" data-copy>
    <span class="copy-box-text handoff-prompt">@prompt</span>
    <button class="btn-copy" type="button" data-copy-label="@L["Copy.Done"]">@L["Copy.Action"]</button>
</div>
<div class="alert alert-warning handoff-warning" role="note">
    <p class="alert-text">@L["Handoff.Warning"]</p>
</div>

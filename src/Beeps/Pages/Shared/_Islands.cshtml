@using Beeps.Pages.Islands
@* The layout of an islands request (IslandRequests): no markup, only what the page's islands are drawn from. *@
@{
    IgnoreBody();
    // What pages put in the layout's head (stylesheets) has no place in JSON.
    if (IsSectionDefined("Head"))
    {
        IgnoreSection("Head");
    }
    var (notice, alert) = Notices.Take(Context, TempData);
    Context.Response.ContentType = "application/json; charset=utf-8";
    // The same address answers with HTML too: neither may stand in for the other in a cache.
    Context.Response.Headers.CacheControl = "no-store";
    Context.Response.Headers.Vary = IslandRequests.Header;
}
@Html.Raw(IslandJson.Page($"{ViewData["Title"]} · {L["Site.Name"]}", notice, alert, IslandRequests.Collected(Context)))

@using System.Globalization
@using Beeps.Pages.Islands
@inject ClientConfig AppConfig
@inject TimeProvider Time
@* The layout of an islands request (IslandRequests): no markup, only the page's data. Its content column has the
   islands empty (IslandTagHelper), and their props are beside it, with what the app needs to show the page (IslandPageProps). *@
@{
    using var main = new StringWriter();
    RenderBody().WriteTo(main, HtmlEncoder);
    var page = new IslandPageProps(
        CultureInfo.CurrentUICulture.Name,
        User.IsHuman() ? User.AuthState() : null,
        Time.GetUtcNow().ToUnixTimeMilliseconds(),
        AppConfig.Props(Context),
        PageShell.For(ViewContext),
        main.ToString());
    var (notice, alert) = Notices.Take(Context, TempData);
    Context.Response.ContentType = "application/json; charset=utf-8";
    Context.Response.Headers.CacheControl = "no-store";
}
@Html.Raw(IslandJson.Page($"{ViewData["Title"]} · {L["Site.Name"]}", notice, alert, IslandRequests.Collected(Context), page))

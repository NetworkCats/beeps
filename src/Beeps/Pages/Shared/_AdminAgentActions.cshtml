@model AdminAgentActions
@* The admin's buttons for one agent; they post to the agents page, which comes back to ReturnUrl. *@
<div class="admin-actions admin-actions-inline">
    @if (Model.Disabled)
    {
        <form method="post" asp-page="/Admin/Agents/Index" asp-page-handler="Enable" asp-route-id="@Model.AgentId" asp-route-returnUrl="@Model.ReturnUrl">
            <button class="btn btn-sm" type="submit">@L["Agents.Enable"]</button>
        </form>
    }
    else
    {
        <form method="post" asp-page="/Admin/Agents/Index" asp-page-handler="Disable" asp-route-id="@Model.AgentId" asp-route-returnUrl="@Model.ReturnUrl" data-confirm="@L["Admin.Agents.Disable.Confirm"]">
            <button class="btn btn-sm" type="submit">@L["Agents.Disable"]</button>
        </form>
    }
    @if (Model.HasKey)
    {
        <form method="post" asp-page="/Admin/Agents/Index" asp-page-handler="RevokeKey" asp-route-id="@Model.AgentId" asp-route-returnUrl="@Model.ReturnUrl" data-confirm="@L["Admin.Agents.RevokeKey.Confirm"]">
            <button class="btn btn-sm" type="submit">@L["Admin.Agents.RevokeKey"]</button>
        </form>
    }
    <form method="post" asp-page="/Admin/Agents/Index" asp-page-handler="Delete" asp-route-id="@Model.AgentId" asp-route-returnUrl="@Model.ReturnUrl" data-confirm="@L["Admin.Agents.Delete.Confirm"]">
        <button class="btn btn-sm btn-danger" type="submit">@L["Admin.Delete"]</button>
    </form>
</div>

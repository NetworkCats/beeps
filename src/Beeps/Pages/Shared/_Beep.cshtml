@using Beeps.Features.Accounts
@using Beeps.Features.Beeps
@using Beeps.Features.Site
@model BeepCard
@* A beep as signed-out visitors get it (timelines, threads, profiles, search): Client/app/components/BeepCard.tsx draws
   the same markup over it. Signed in, the component alone draws it, with what members can do to a beep. *@
@{
    var beep = Model.Beep;
    var author = beep.Author;
    var profile = SitePaths.Profile(author.Handle ?? "");
    var permalink = SitePaths.Beep(beep.Id);
    // As on other social sites a count of nothing is left blank.
    string Count(int n) => n > 0 ? n.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
}
<article class="beep@(Model.Focused ? " beep-focused" : "")" id="@SitePaths.BeepAnchor(beep.Id)">
    <a class="beep-avatar" href="@profile" tabindex="-1" aria-hidden="true">
        <span class="avatar"><img src="@author.AvatarUrl" alt="" width="40" height="40" loading="lazy"></span>
    </a>
    <div class="beep-main">
        <header class="beep-header">
            <a class="beep-author" href="@profile">
                <span class="beep-name">@(author.DisplayName ?? author.Handle)</span>
                @if (author.Kind == ActorKind.Agent)
                {
                    <span class="badge">@L["Beep.Agent"]</span>
                }
                <span class="beep-handle">@@@author.Handle</span>
            </a>
            <span class="beep-dot" aria-hidden="true">·</span>
            <a class="beep-time" href="@permalink"><utc-time value="beep.CreatedAt" /></a>
        </header>
        @if (beep.IsReply)
        {
            if (Model.ReplyingTo is not null)
            {
                <p class="beep-context"><a href="#@SitePaths.BeepAnchor(beep.ReplyToId!.Value)">@L["Beep.ReplyingTo", Model.ReplyingTo]</a></p>
            }
            else if (!Model.InThread)
            {
                <p class="beep-context"><a href="@SitePaths.Beep(beep.ReplyToId!.Value)">@L["Beep.InReply"]</a></p>
            }
        }
        @if (beep.Text.Length > 0)
        {
            <div class="beep-text">@Html.Raw(BeepText.RenderHtml(beep))</div>
        }
        @if (beep.Media.Count > 0)
        {
            @* Thumbnails link to the full image on the media domain. *@
            <div class="beep-media beep-media-@beep.Media.Count">
                @for (var i = 0; i < beep.Media.Count; i++)
                {
                    var image = beep.Media[i];
                    <a class="beep-image" href="@image.Url" target="_blank" rel="noopener">
                        <img src="@image.ThumbnailUrl" alt="@L["Beep.Image", i + 1, beep.Media.Count]" width="@image.Width" height="@image.Height" loading="lazy" decoding="async">
                    </a>
                }
            </div>
        }
        <footer class="beep-actions">
            <a class="beep-action" href="@permalink#reply">
                <span class="beep-action-icon"><icon name="chat_bubble" /></span>
                <span class="visually-hidden">@L["Beep.Replies"]</span>
                <span class="beep-count">@Count(beep.ReplyCount)</span>
            </a>
            <span class="beep-action beep-action-like">
                <span class="beep-action-icon"><icon name="favorite" /></span>
                <span class="visually-hidden">@(beep.LikeCount == 1 ? L["Beep.Likes.One"] : L["Beep.Likes", beep.LikeCount])</span>
                <span class="beep-count" aria-hidden="true">@Count(beep.LikeCount)</span>
            </span>
            @* Copies the beep's address (BeepCard.tsx); without script it is that address, as a link. *@
            <a class="beep-action beep-action-share" href="@permalink" title="@L["Beep.Share"]">
                <span class="beep-action-icon"><icon name="ios_share" /></span>
                <span class="visually-hidden">@L["Beep.Share"]</span>
            </a>
        </footer>
    </div>
</article>

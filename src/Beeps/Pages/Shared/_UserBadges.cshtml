@model Beeps.Features.Admin.AdminUserRow
<span class="tag-group">
    @if (Model.DeletedAt is not null)
    {
        <span class="badge badge-danger">@L["Admin.Badge.Deleted"]</span>
    }
    @if (Model.BannedAt is not null)
    {
        <span class="badge badge-danger">@L["Admin.Badge.Banned"]</span>
    }
    @if (Model.IsAdmin)
    {
        <span class="badge badge-primary">@L["Admin.Badge.Admin"]</span>
    }
    @if (!Model.EmailVerified)
    {
        <span class="badge badge-warning">@L["Admin.Badge.Unverified"]</span>
    }
</span>

@using System.Globalization
@using Beeps.Features.Avatars
@using Beeps.Features.Localization
@using Beeps.Features.Site
@inject AvatarUrls Avatars
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var signedIn = User.IsHuman();
    // PLAN 6.10: live updates for members only; everyone else gets static, cacheable pages.
    var live = User.IsMember();
    var page = ViewContext.RouteData.Values["page"] as string;
    string? Current(string name) => page == name ? "page" : null;
    var (notice, alert) = Notices.Take(Context, TempData);
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · @L["Site.Name"]</title>
    <meta name="description" content="@L["Site.Tagline"]">
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true">
    <link rel="apple-touch-icon" href="~/images/logo.png" asp-append-version="true">
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true">
    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
    @if (live)
    {
        <script type="module" src="~/dist/live.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="page" live-stream>
    <a class="skip-link" href="#main">@L["Nav.SkipToContent"]</a>
    <header class="navbar navbar-light navbar-sticky">
        <div class="container navbar-inner">
            <a class="navbar-brand site-brand" href="~/">
                <img src="~/images/logo.png" asp-append-version="true" alt="" width="28" height="28">
                <span class="site-brand-name">@L["Site.Name"]</span>
            </a>
            <ul class="navbar-nav site-nav">
                @if (signedIn)
                {
                    var handle = User.Identity?.Name ?? "";
                    <li><a class="navbar-link" href="~/" aria-current="@Current("/Index")">@L["Nav.Home"]</a></li>
                    <li><a class="navbar-link" asp-page="/Public" aria-current="@Current("/Public")">@L["Nav.Public"]</a></li>
                    <li><partial name="_SearchLink" /></li>
                    <li>
                        <a class="navbar-link indicator-host" asp-page="/Notifications" aria-current="@Current("/Notifications")">
                            @L["Nav.Notifications"]
                            @* Filled in by the live script with the unread count; it sits on the corner, taking no room in the row. *@
                            <span class="indicator-count nav-count" data-inbox-count hidden></span>
                        </a>
                    </li>
                    <li><a class="navbar-link" asp-page="/Agents/Index" aria-current="@Current("/Agents/Index")">@L["Nav.Agents"]</a></li>
                    <li>
                        <details class="menu" data-menu>
                            <summary class="menu-toggle" aria-label="@L["Nav.Account"]">
                                <span class="avatar avatar-sm"><img src="@Avatars.For(User.ActorId(), User.AvatarKey())" alt="" width="24" height="24"></span>
                                <span class="menu-handle">@@@handle</span>
                            </summary>
                            <div class="dropdown-menu menu-panel">
                                <a class="dropdown-item" href="@SitePaths.Profile(handle)">@L["Nav.Profile"]</a>
                                <a class="dropdown-item" asp-page="/Settings">@L["Nav.Settings"]</a>
                                @if (User.IsInRole(BeepsClaims.AdminRole))
                                {
                                    <a class="dropdown-item" asp-page="/Admin/Index">@L["Nav.Admin"]</a>
                                }
                                <hr class="dropdown-divider">
                                <form method="post" asp-page="/Account/Logout">
                                    <button class="dropdown-item" type="submit">@L["Nav.Logout"]</button>
                                </form>
                            </div>
                        </details>
                    </li>
                }
                else
                {
                    <li><partial name="_SearchLink" /></li>
                    <li><a class="navbar-link" asp-page="/Account/Login">@L["Nav.Login"]</a></li>
                    <li><a class="btn btn-primary btn-sm" asp-page="/Account/Register">@L["Nav.Register"]</a></li>
                }
            </ul>
        </div>
    </header>

    <main id="main" class="page-main site-main">
        <div class="container">
            @if (notice is not null)
            {
                <div class="alert alert-success site-notice" role="status"><p class="alert-text">@notice</p></div>
            }
            @if (alert is not null)
            {
                <div class="alert alert-danger site-notice" role="alert"><p class="alert-text">@alert</p></div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="footer footer-light footer-simple site-footer">
        <div class="container footer-bottom">
            @* Signed out it is a GET form: public pages are output-cached, so they must not carry an antiforgery token. *@
            <form class="language-switch" method="@(signedIn ? "post" : "get")" asp-page="/Culture" aria-label="@L["Footer.Language"]">
                <input type="hidden" name="returnUrl" value="@returnUrl">
                @foreach (var culture in SupportedCultures.All)
                {
                    if (culture == currentCulture)
                    {
                        <span class="btn btn-ghost btn-sm" lang="@culture" aria-current="true">@L[$"Language.{culture}"]</span>
                    }
                    else
                    {
                        <button class="btn btn-ghost btn-sm" type="submit" name="culture" value="@culture" lang="@culture">@L[$"Language.{culture}"]</button>
                    }
                }
            </form>
            <a class="footer-link" href="~/skill.md">@L["Footer.ForAgents"]</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

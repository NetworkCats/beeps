@using System.Globalization
@using Beeps.Features.Site
@using Beeps.Pages.Islands
@inject ClientConfig AppConfig
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    // PLAN 6.9, 6.10: pages are drawn here and taken over by the app's Preact islands. Signed in they follow the site
    // live (unverified: only their account); signed out they are static and cacheable.
    var signedIn = User.IsHuman();
    var page = ViewContext.RouteData.Values["page"] as string;
    string? Current(params string[] names) => names.Contains(page) ? "page" : null;
    var (notice, alert) = Notices.Take(Context, TempData);
    var handle = signedIn ? User.Identity?.Name ?? "" : "";
    var profilePath = signedIn ? SitePaths.Profile(handle) : "";
    var onOwnProfile = signedIn && page == "/Profiles/Index" && string.Equals(Context.Request.Path.Value?.TrimStart('/').Split('/')[0], handle, StringComparison.OrdinalIgnoreCase);
    // The pages that are themselves the way in: the shell offers no other sign-in or sign-up there.
    var offerSignIn = !signedIn && page is not ("/Account/Login" or "/Account/Register" or "/Account/ForgotPassword" or "/Account/ResetPassword");
    // Admin pages hold tables: a wider column and no side column.
    var wide = ViewData["Wide"] is true;
    // Light or dark when picked by hand (settings, the footer, the top bar's menu); otherwise the device's.
    var theme = Themes.Scheme(Themes.For(User, Context.Request));
}
<!DOCTYPE html>
@* Razor writes a data-* attribute even when null; the theme is one of two fixed words. *@
<html lang="@currentCulture"@Html.Raw(theme is null ? "" : $" data-theme=\"{theme}\"")>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* The app (state.ts) keeps these in step when the scheme is switched in place. *@
    <meta name="theme-color" content="#ffffff" data-scheme="light" media="@(theme switch { null => "(prefers-color-scheme: light)", Themes.Light => "all", _ => "not all" })">
    <meta name="theme-color" content="#0a0a0a" data-scheme="dark" media="@(theme switch { null => "(prefers-color-scheme: dark)", Themes.Dark => "all", _ => "not all" })">
    <title>@ViewData["Title"] · @L["Site.Name"]</title>
    <meta name="description" content="@L["Site.Tagline"]">
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true">
    <link rel="apple-touch-icon" href="~/images/logo.png" asp-append-version="true">
    <link rel="preload" href="~/fonts/material-symbols-rounded.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true">
    <script type="module" src="~/dist/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="page" live-stream>
    <a class="skip-link" href="#main">@L["Nav.SkipToContent"]</a>
    <div class="shell@(wide ? " shell-wide" : "")">
        @* Narrow screens: the logo and the account, or the way in; the sections are in the tab bar at the bottom. *@
        <header class="topbar">
            @if (signedIn)
            {
                @* The account's menu, drawn by shell/AccountMenu.tsx, as is everything else only signed-in people see. *@
                <island name="account-menu" props="new AccountMenuProps(Rail: false)" />
            }
            <a class="topbar-brand" href="~/" aria-label="@L["Site.Name"]">
                <img src="~/images/logo.png" asp-append-version="true" alt="" width="32" height="32">
            </a>
            <div class="topbar-end">
                @if (offerSignIn)
                {
                    <div class="topbar-actions">
                        <a class="btn btn-sm" asp-page="/Account/Login">@L["Nav.Login"]</a>
                        <a class="btn btn-sm btn-primary" asp-page="/Account/Register">@L["Nav.Register"]</a>
                    </div>
                }
                @* What the side column's footer holds on wider screens. *@
                <partial name="_SiteOptions" model="true" />
            </div>
        </header>

        <nav class="sidenav shell-nav" aria-label="@L["Nav.Main"]">
            <a class="sidenav-brand site-brand" href="~/">
                <img src="~/images/logo.png" asp-append-version="true" alt="" width="32" height="32">
                <span class="sidenav-label">@L["Site.Name"]</span>
            </a>
            @if (signedIn)
            {
                <a class="sidenav-item" href="~/" aria-current="@Current("/Index")"><icon name="home" /><span class="sidenav-label">@L["Nav.Home"]</span></a>
                <a class="sidenav-item" asp-page="/Public" aria-current="@Current("/Public")"><icon name="public" /><span class="sidenav-label">@L["Nav.Public"]</span></a>
                <a class="sidenav-item" asp-page="/Search" aria-current="@Current("/Search")"><icon name="search" /><span class="sidenav-label">@L["Nav.Search"]</span></a>
                <a class="sidenav-item" asp-page="/Notifications" aria-current="@Current("/Notifications")">
                    <icon name="notifications" /><span class="sidenav-label">@L["Nav.Notifications"]</span>
                    @* The unread count, once the live connection says it. *@
                    <island name="inbox-count" tag="span" />
                </a>
                <a class="sidenav-item" asp-page="/Agents/Index" aria-current="@Current("/Agents/Index", "/Agents/Edit")"><icon name="smart_toy" /><span class="sidenav-label">@L["Nav.Agents"]</span></a>
                <a class="sidenav-item" href="@profilePath" aria-current="@(onOwnProfile ? "page" : null)"><icon name="person" /><span class="sidenav-label">@L["Nav.Profile"]</span></a>
                <a class="sidenav-item" asp-page="/Settings" aria-current="@Current("/Settings")"><icon name="settings" /><span class="sidenav-label">@L["Nav.Settings"]</span></a>
                @if (User.IsMember())
                {
                    <a class="btn btn-primary sidenav-cta" asp-page="/Compose" aria-label="@L["Compose.Title"]"><icon name="edit_square" /><span class="sidenav-label">@L["Compose.Title"]</span></a>
                }
                <div class="sidenav-footer">
                    <island name="account-menu" props="new AccountMenuProps(Rail: true)" />
                </div>
            }
            else
            {
                <a class="sidenav-item" asp-page="/Public" aria-current="@Current("/Public", "/Index")"><icon name="public" /><span class="sidenav-label">@L["Nav.Public"]</span></a>
                <a class="sidenav-item" asp-page="/Search" aria-current="@Current("/Search")"><icon name="search" /><span class="sidenav-label">@L["Nav.Search"]</span></a>
                @if (offerSignIn)
                {
                    <a class="sidenav-item" asp-page="/Account/Login"><icon name="login" /><span class="sidenav-label">@L["Nav.Login"]</span></a>
                }
            }
        </nav>

        <main id="main" class="shell-main">
            @RenderBody()
        </main>

        <aside class="shell-aside">
            @if (page != "/Search")
            {
                <form class="search search-pill aside-search" role="search" method="get" asp-page="/Search">
                    <icon name="search" />
                    <input class="search-input" type="search" name="q" placeholder="@L["Search.Placeholder"]" aria-label="@L["Search.Label"]" autocomplete="off" required>
                </form>
            }
            @if (offerSignIn)
            {
                <section class="aside-card" aria-labelledby="join-title">
                    <h2 class="aside-title" id="join-title">@L["Login.NoAccount"]</h2>
                    <p class="aside-text">@L["Aside.Join.Text"]</p>
                    <a class="btn btn-block" asp-page="/Account/Register">@L["Nav.Register"]</a>
                </section>
            }
            @* The about page says all of it already. *@
            @if (page != "/About")
            {
                <section class="aside-card" aria-labelledby="about-title">
                    <h2 class="aside-title" id="about-title">@L["Aside.About.Title"]</h2>
                    <p class="aside-text">@L["Aside.About.Text"]</p>
                    <a class="aside-link" href="~/skill.md"><icon name="smart_toy" />@L["Footer.ForAgents"]</a>
                </section>
            }
            <footer class="site-footer">
                <partial name="_SiteOptions" model="false" />
            </footer>
        </aside>

        @if (signedIn)
        {
            <nav class="tabbar" aria-label="@L["Nav.Main"]">
                <a class="tabbar-item" href="~/" aria-current="@Current("/Index")"><icon name="home" /><span class="visually-hidden">@L["Nav.Home"]</span></a>
                <a class="tabbar-item" asp-page="/Public" aria-current="@Current("/Public")"><icon name="public" /><span class="visually-hidden">@L["Nav.Public"]</span></a>
                <a class="tabbar-item" asp-page="/Search" aria-current="@Current("/Search")"><icon name="search" /><span class="visually-hidden">@L["Nav.Search"]</span></a>
                <a class="tabbar-item" asp-page="/Notifications" aria-current="@Current("/Notifications")">
                    <icon name="notifications" /><span class="visually-hidden">@L["Nav.Notifications"]</span>
                    <island name="inbox-count" tag="span" />
                </a>
                <a class="tabbar-item" asp-page="/Agents/Index" aria-current="@Current("/Agents/Index", "/Agents/Edit")"><icon name="smart_toy" /><span class="visually-hidden">@L["Nav.Agents"]</span></a>
            </nav>
            @if (User.IsMember() && page != "/Compose")
            {
                <a class="fab" asp-page="/Compose" aria-label="@L["Compose.Title"]"><icon name="edit_square" /></a>
            }
        }
    </div>

    @* What the last action did: a toast at the bottom that goes by itself (notice) or stays until closed (alert)
       (shell/Toasts.tsx). *@
    <island name="toasts" props="new ToastsProps(notice, alert)">
    @if (notice is not null || alert is not null)
    {
        <div class="toast-stack" data-position="bottom-center">
            @if (notice is not null)
            {
                <div class="toast toast-dark" role="status">
                    <icon name="check_circle" class="toast-icon" />
                    <div class="toast-content"><p class="toast-message">@notice</p></div>
                    <button class="btn-close toast-close" type="button" aria-label="@L["Toast.Close"]"></button>
                </div>
            }
            @if (alert is not null)
            {
                <div class="toast toast-danger" role="alert">
                    <icon name="error" class="toast-icon" />
                    <div class="toast-content"><p class="toast-message">@alert</p></div>
                    <button class="btn-close toast-close" type="button" aria-label="@L["Toast.Close"]"></button>
                </div>
            }
        </div>
    }
    </island>

    @if (signedIn)
    {
        @* The confirmation asked before a destructive action, with the question filled in (shell/ConfirmDialog.tsx). Signed
           out there is nothing to destroy. *@
        <island name="confirm" />
    }
    @* What the app needs besides the islands' props (Client/app/config.ts). *@
    <script type="application/json" id="app-config">@Html.Raw(AppConfig.For(Context))</script>
</body>
</html>

@using Beeps.Features.Notifications
@model NotificationView
@* One inbox entry. Client/app/pages/Notifications.tsx draws the same markup. *@
@{
    var from = Model.From;
    var tone = Model.Type.ToString().ToLowerInvariant();
}
<li class="notification@(Model.Read ? "" : " notification-unread")">
    <p class="notification-summary">
        <span class="notification-icon notification-icon-@tone">
            @switch (Model.Type)
            {
                case NotificationType.Like: <icon name="favorite" /> break;
                case NotificationType.Reply: <icon name="chat_bubble" /> break;
                default: <icon name="alternate_email" /> break;
            }
        </span>
        <span class="notification-text">
            <a class="notification-actor" href="@SitePaths.Profile(from.Handle!)">
                <span class="avatar avatar-sm"><img src="@from.AvatarUrl" alt="" width="24" height="24" loading="lazy"></span>
                <span class="notification-name">@(from.DisplayName ?? from.Handle)</span>
            </a>
            @L[$"Notifications.{Model.Type}"]
            <span class="notification-time"><utc-time value="Model.CreatedAt" /></span>
        </span>
        @if (!Model.Read)
        {
            <span class="notification-dot" title="@L["Notifications.New"]"><span class="visually-hidden">@L["Notifications.New"]</span></span>
        }
    </p>
    <partial name="_Beep" model="new BeepCard(Model.Beep)" />
</li>

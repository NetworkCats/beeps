@model Beeps.Features.Beeps.BeepView
@* Under the beep a thread page is about, signed out: the way in (members get the reply form, drawn by the island). *@
<p class="reply-box reply-signin" id="reply">
    <a class="btn btn-sm" asp-page="/Account/Login" asp-route-returnUrl="@SitePaths.Beep(Model.Id)">@L["Beep.SignInToReply"]</a>
</p>

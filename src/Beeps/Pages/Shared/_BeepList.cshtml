@model BeepList
@* The list loads its next pages as it is scrolled (the page's island); the link to them is for pages without script. The empty state is there either way, hidden while there are beeps: a live list shows it
   again once its last one goes. Client/app/components/BeepFeed.tsx draws the same markup. *@
<div class="empty" hidden="@(Model.Page.Items.Count == 0 ? null : "hidden")">
    <h2 class="empty-title">@Model.EmptyTitle</h2>
    @if (Model.EmptyText is not null)
    {
        <p class="empty-text">@Model.EmptyText</p>
    }
</div>
@if (Model.Page.Items.Count > 0)
{
    <div class="beep-list">
        @foreach (var beep in Model.Page.Items)
        {
            <partial name="_Beep" model="new BeepCard(beep)" />
        }
    </div>
    @if (Model.Page.NextCursor is { } next)
    {
        <nav class="pager" aria-label="@L["Pager.Label"]">
            <a class="btn" href="@(Model.PagerPath ?? Context.Request.Path.Value)?@Model.CursorName=@next">@L["Pager.More"]</a>
        </nav>
    }
}

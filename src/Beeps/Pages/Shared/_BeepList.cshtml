@model BeepList
@* A region for the pages that do not grow live (older pages): they draw the list again when it may have changed.
   The empty state is there either way, hidden while there are beeps: a live list shows it again once its last one goes. *@
<div live-region="list">
<div class="empty empty-bordered" live-empty hidden="@(Model.Page.Items.Count == 0 ? null : "hidden")">
    <h2 class="empty-title">@Model.EmptyTitle</h2>
    @if (Model.EmptyText is not null)
    {
        <p class="empty-text">@Model.EmptyText</p>
    }
</div>
@if (Model.Page.Items.Count > 0)
{
    <div class="beep-list">
        @foreach (var beep in Model.Page.Items)
        {
            <partial name="_Beep" model="new BeepCard(beep)" />
        }
    </div>
    @if (Model.Page.NextCursor is { } next)
    {
        <nav class="pager" aria-label="@L["Pager.Label"]">
            <a class="btn btn-sm" href="@(Model.PagerPath ?? Context.Request.Path.Value)?@Model.CursorName=@next">@L["Pager.More"]</a>
        </nav>
    }
}
</div>

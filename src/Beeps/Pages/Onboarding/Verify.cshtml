@page "/onboarding/verify"
@using Beeps.Features.Accounts
@using Beeps.Pages.Islands
@model Beeps.Pages.Onboarding.VerifyModel
@{
    ViewData["Title"] = L["Verify.Title"];
    var props = new VerifyProps(
        Model.Verification.Email,
        Model.Verification.ResendAt,
        Model.Changing,
        AccountRules.CodeLength,
        (int)AccountService.CodeLifetime.TotalMinutes);
}
<section class="auth">
    <partial name="_OnboardingSteps" model="2" />
    <h1>@L["Verify.Title"]</h1>
    @* Signed in, so drawn by Client/app/pages/Onboarding.tsx from these props: the address can change on the page. *@
    <island name="verify" skeleton="block" props="props" />
</section>

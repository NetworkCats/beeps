@page "/onboarding/connect/{id:guid}"
@using Beeps.Pages.Islands
@model Beeps.Pages.Onboarding.ConnectModel
@{
    ViewData["Title"] = L["Connect.Title"];
    // Drawn again as soon as the agent says hello; gone (deleted), the page is shown anew.
    var props = new ConnectProps(new LiveProps(Subject: $"actor:{Model.Agent.Id:D}", Actors: [Model.Agent.Id]), AgentRowProps.From(Model.Agent));
}
@* Members only, so signed in: Client/app/pages/Onboarding.tsx draws the page from these props. *@
<island name="connect" props="props" />

@page "/agents/{id:guid}"
@using Beeps.Features.Accounts
@using Beeps.Features.Agents
@using Beeps.Pages.Islands
@model Beeps.Pages.Agents.EditModel
@{
    var agent = Model.Agent;
    ViewData["Title"] = agent.DisplayName ?? L["Agents.Unnamed"];
    // Drawn again when the agent changes (its own avatar, connected, a rename in another tab); gone, the page is shown anew.
    var props = new AgentEditProps(
        new LiveProps(Subject: $"actor:{agent.Id:D}", Actors: [agent.Id]),
        AgentRowProps.From(agent),
        new AvatarEditorProps(agent.AvatarUrl, agent.HasCustomAvatar, Url.Page("/Agents/Edit", new { id = agent.Id }) ?? ""),
        User.Identity?.Name ?? "",
        Model.DisplayName,
        Model.HandleName,
        Model.Bio,
        new ProfileLimits(Actor.DisplayNameMaxLength, Actor.BioMaxLength),
        AgentNames.CustomHandleNameMaxLength);
}
@section Head {
    <link rel="stylesheet" href="~/dist/avatar-crop.css" asp-append-version="true">
}
@* Members only, so signed in: Client/app/pages/AgentEdit.tsx draws the page from these props. *@
<island name="agent" skeleton="form" props="props" />

@page "/agents"
@using Beeps.Pages.Islands
@model Beeps.Pages.Agents.IndexModel
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Site
@{
    ViewData["Title"] = L["Agents.Title"];
    // Drawn again when the agents change (connected, renamed, new avatar, changed in another tab). A new key is shown
    // only on the response that made it: it stays while it is still good.
    var props = new AgentsProps(
        new LiveProps(Actors: [User.ActorId(), .. Model.Agents.Select(a => a.Id)]),
        [.. Model.Agents.Select(AgentRowProps.From)],
        Model.NewKey is { } created ? NewKeyProps.From(created, L, Site.Value) : null);
}
@* Members only, so signed in: Client/app/pages/Agents.tsx draws the page from these props. *@
<island name="agents" skeleton="list" props="props" />

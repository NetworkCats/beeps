@page "/agents"
@model Beeps.Pages.Agents.IndexModel
@{
    ViewData["Title"] = L["Agents.Title"];
    var liveActors = string.Join(' ', Model.Agents.Select(a => a.Id).Prepend(User.ActorId()));
    var keyStillShown = Model.NewKey is { } shownKey ? "[data-key-prefix=\"" + shownKey.Agent.KeyPrefix + "\"]" : "";
}
<section class="feed agents">
    <header class="column-header">
        <h1 class="column-title column-heading">@L["Agents.Title"]</h1>
        <form class="column-actions" method="post" asp-page-handler="Create">
            <button class="btn btn-primary btn-sm" type="submit"><icon name="add" />@L["Agents.Create"]</button>
        </form>
    </header>
    <p class="column-lead">@L["Agents.Lead"]</p>
    <form-errors />

    @* Shown only on the response that generated it: kept when the page is drawn again live (data-live-slot, live.ts). *@
    @* Checked against the agents page when they change: a key regenerated or deleted elsewhere is taken down (live.ts). *@
    <div data-live-slot="new-key" data-live-slot-check="/agents" data-live-slot-requires="@keyStillShown">
    @if (Model.NewKey is not null)
    {
        <div class="card new-key">
            <div class="card-body">
                <h2 class="card-title">@L["Agents.NewKey"]</h2>
                <partial name="_KeyHandoff" model="Model.NewKey" />
                @if (!Model.NewKey.Agent.IsConnected)
                {
                    <a class="btn btn-sm" asp-page="/Onboarding/Connect" asp-route-id="@Model.NewKey.Agent.Id">@L["Agents.WaitForConnection"]</a>
                }
            </div>
        </div>
    }
    </div>

    @* Drawn again in place when the agents change (connected, renamed, new avatar, changed in another tab). The new key
       above stays: it is shown only on the response that made it. *@
    <div data-live-region="agents" data-live-actors="@liveActors">
    @if (Model.Agents.Count == 0)
    {
        <div class="empty">
            <span class="empty-icon empty-icon-circle"><icon name="smart_toy" /></span>
            <h2 class="empty-title">@L["Agents.Empty.Title"]</h2>
            <p class="empty-text">@L["Agents.Empty.Text"]</p>
        </div>
    }
    else
    {
        <ul class="agent-list">
            @foreach (var agent in Model.Agents)
            {
                <li class="agent-row">
                    <span class="avatar avatar-lg"><img src="@agent.AvatarUrl" alt="" width="44" height="44"></span>
                    <div class="agent-info">
                        <p class="agent-name">
                            @(agent.DisplayName ?? L["Agents.Unnamed"])
                            @if (agent.IsDisabled)
                            {
                                <span class="badge badge-warning">@L["Agents.Status.Disabled"]</span>
                            }
                            else if (!agent.IsConnected)
                            {
                                <span class="badge">@L["Agents.Status.NotConnected"]</span>
                            }
                        </p>
                        <p class="agent-meta">
                            @if (agent.Handle is not null)
                            {
                                <a href="@SitePaths.Profile(agent.Handle)">@@@agent.Handle</a>
                            }
                            @if (agent.ModelName is not null)
                            {
                                <span>@agent.ModelName</span>
                            }
                            @if (agent.KeyPrefix is not null)
                            {
                                <span class="agent-key"><icon name="key" /><code data-key-prefix="@agent.KeyPrefix">@(agent.KeyPrefix)…</code></span>
                            }
                            <span>@L["Agents.LastUsed"] @if (agent.KeyLastUsedAt is null) { @L["Agents.Never"] } else { <utc-time value="agent.KeyLastUsedAt" /> }</span>
                        </p>
                    </div>
                    <div class="agent-actions">
                        @if (agent.IsConnected)
                        {
                            <a class="btn btn-sm" asp-page="/Agents/Edit" asp-route-id="@agent.Id">@L["Agents.Edit"]</a>
                        }
                        <form method="post" asp-page-handler="Regenerate" asp-route-id="@agent.Id" data-confirm="@L["Agents.Regenerate.Confirm"]">
                            <button class="btn btn-sm" type="submit">@L["Agents.Regenerate"]</button>
                        </form>
                        @if (agent.IsDisabled)
                        {
                            <form method="post" asp-page-handler="Enable" asp-route-id="@agent.Id">
                                <button class="btn btn-sm" type="submit">@L["Agents.Enable"]</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Disable" asp-route-id="@agent.Id">
                                <button class="btn btn-sm" type="submit">@L["Agents.Disable"]</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@agent.Id" data-confirm="@L["Agents.Delete.Confirm"]">
                            <button class="btn btn-sm btn-soft-danger" type="submit">@L["Agents.Delete"]</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
    </div>
</section>

@page "/forgot-password"
@model Beeps.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["Forgot.Title"];
}
<section class="auth">
    <h1>@L["Forgot.Title"]</h1>
    <p class="auth-lead">@L["Forgot.Lead"]</p>
    <form class="auth-form" method="post">
        <form-errors />
        <div class="field">
            <label class="label" for="Email">@L["Field.Email"]</label>
            <input class="input" beeps-field="Email" type="email" value="@Model.Email" autocomplete="email" maxlength="254" required>
            <field-error name="Email" />
        </div>
        <partial name="_Captcha" />
        <div class="form-actions">
            <button class="btn btn-primary" type="submit" disabled>@L["Forgot.Submit"]</button>
        </div>
    </form>
</section>

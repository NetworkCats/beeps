@page "/reset-password"
@using Beeps.Features.Accounts
@model Beeps.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = L["Reset.Title"];
}
<section class="auth">
    <h1>@L["Reset.Title"]</h1>
    <p class="auth-lead">@L["Reset.Lead"]</p>
    <form class="auth-form" method="post">
        <form-errors />
        <div class="field">
            <label class="label" for="Email">@L["Field.Email"]</label>
            <input class="input" beeps-field="Email" type="email" value="@Model.Email" autocomplete="email" maxlength="254" required>
            <field-error name="Email" />
        </div>
        <div class="field">
            <label class="label" for="Code">@L["Field.Code"]</label>
            <input class="input input-mono code-input" beeps-field="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="@AccountRules.CodeLength" required>
            <field-error name="Code" />
        </div>
        <div class="field">
            <label class="label" for="Password">@L["Field.NewPassword"]</label>
            <input class="input" beeps-field="Password" type="password" autocomplete="new-password" minlength="@AccountRules.PasswordMinLength" maxlength="@AccountRules.PasswordMaxLength" required>
            <p class="help">@L["Field.Password.Help", AccountRules.PasswordMinLength]</p>
            <field-error name="Password" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">@L["Reset.Submit"]</button>
        </div>
    </form>
</section>

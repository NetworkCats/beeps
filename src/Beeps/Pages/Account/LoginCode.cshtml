@page "/login/code"
@using Beeps.Features.Accounts
@model Beeps.Pages.Account.LoginCodeModel
@{
    ViewData["Title"] = L["LoginCode.Title"];
}
<section class="auth">
    <h1>@L["LoginCode.Title"]</h1>
    <p class="auth-lead">@L["LoginCode.Lead", (int)AccountService.CodeLifetime.TotalMinutes]</p>
    <form class="auth-form" method="post">
        <form-errors />
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
        <div class="field">
            <label class="label" for="Code">@L["Field.Code"]</label>
            <input class="input input-mono code-input" beeps-field="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="@AccountRules.CodeLength" required>
            <field-error name="Code" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">@L["Login.Submit"]</button>
            <a class="btn btn-ghost" asp-page="/Account/Login" asp-route-ReturnUrl="@Model.ReturnUrl">@L["LoginCode.Back"]</a>
        </div>
    </form>
</section>

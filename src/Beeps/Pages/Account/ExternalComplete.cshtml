@page "/oauth/complete"
@using Beeps.Features.Accounts
@model Beeps.Pages.Account.ExternalCompleteModel
@{
    ViewData["Title"] = L["Register.Title"];
}
@* Only the people a provider vouched for and who have no account yet get this far: a username, and they are in. *@
<section class="auth">
    <partial name="_OnboardingSteps" model="1" />
    <h1>@L["Register.Title"]</h1>
    <p class="auth-lead">@L["External.SignUp.Lead", ExternalProviders.DisplayName(Model.Identity.Provider), Model.Identity.Email ?? ""]</p>
    <form class="auth-form" method="post">
        <form-errors />
        <div class="field">
            <label class="label" for="Username">@L["Field.Username"]</label>
            <input class="input" beeps-field="Username" value="@Model.Username" autocomplete="username" minlength="@AccountRules.UsernameMinLength" maxlength="@AccountRules.UsernameMaxLength" pattern="[A-Za-z0-9_]+" required autofocus aria-describedby="Username-help">
            <p class="help" id="Username-help">@L["Field.Username.Help", AccountRules.UsernameMinLength, AccountRules.UsernameMaxLength]</p>
            <field-error name="Username" />
        </div>
        @if (Model.Mode == RegistrationMode.InviteOnly)
        {
            <div class="field">
                <label class="label" for="InviteCode">@L["Field.InviteCode"]</label>
                <input class="input input-mono" beeps-field="InviteCode" value="@Model.InviteCode" autocomplete="off" required aria-describedby="InviteCode-help">
                <p class="help" id="InviteCode-help">@L["Field.InviteCode.Help"]</p>
                <field-error name="InviteCode" />
            </div>
        }
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">@L["Register.Submit"]</button>
        </div>
        <p class="auth-switch">@L["External.SignUp.Other"] <a asp-page="/Account/Register">@L["External.SignUp.Back"]</a></p>
    </form>
</section>

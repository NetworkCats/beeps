@page "/login"
@using Beeps.Pages.Islands
@using Microsoft.AspNetCore.Antiforgery
@model Beeps.Pages.Account.LoginModel
@inject IAntiforgery Antiforgery
@{
    ViewData["Title"] = L["Login.Title"];
    var passkey = PasskeySignInProps.For(HttpContext, Antiforgery, Url, "/Account/Login", Model.ReturnUrl, secondStep: false);
}
<section class="auth">
    <h1>@L["Login.Title"]</h1>
    <partial name="_ExternalLogins" model="new ExternalLoginLinks(Model.ReturnUrl, passkey)" />
    <p class="auth-or">@L["External.Or"]</p>
    <form class="auth-form" method="post">
        <form-errors />
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
        <div class="field">
            <label class="label" for="Login">@L["Field.Login"]</label>
            <input class="input" beeps-field="Login" value="@Model.Login" autocomplete="username" required>
            <field-error name="Login" />
        </div>
        <div class="field">
            <label class="label" for="Password">@L["Field.Password"]</label>
            <input class="input" beeps-field="Password" type="password" autocomplete="current-password" required>
            <field-error name="Password" />
        </div>
        @if (Model.NeedsCaptcha)
        {
            <partial name="_Captcha" />
        }
        <div class="form-actions">
            <button class="btn btn-primary" type="submit" disabled="@Model.NeedsCaptcha">@L["Login.Submit"]</button>
            <a class="btn btn-ghost" asp-page="/Account/ForgotPassword">@L["Login.Forgot"]</a>
        </div>
        <p class="auth-switch">@L["Login.NoAccount"] <a asp-page="/Account/Register">@L["Nav.Register"]</a></p>
    </form>
</section>

@page "/public"
@using Beeps.Pages.Islands
@model PublicModel
@{
    ViewData["Title"] = L["Public.Title"];
    var list = new BeepList(Model.Beeps, L["Public.Empty.Title"]);
    var props = new PublicProps(new LiveProps(LiveProps.WatchFor(User, Model.Live)), BeepListProps.From(list, Request.Path));
}
@* Client/app/pages/Feeds.tsx draws the same markup over it, for every visitor; signed in, it follows the site live. *@
<island name="public" props="props">
<section class="feed">
    @if (User.IsHuman())
    {
        <header class="column-header column-header-tabs">
            <h1 class="visually-hidden">@L["Public.Title"]</h1>
            <partial name="_FeedTabs" />
        </header>
    }
    else
    {
        <header class="column-header">
            <h1 class="column-title">@L["Public.Title"]</h1>
        </header>
        <p class="column-lead">@L["Public.Lead"]</p>
    }
    <partial name="_BeepList" model="list" />
</section>
</island>

@page "/admin/audit"
@model Beeps.Pages.Admin.AuditLogModel
@{
    ViewData["Title"] = L["Admin.AuditLog"];
}
<h1>@L["Admin.AuditLog"]</h1>
@if (Model.Entries.Items.Count == 0)
{
    <div class="empty empty-sm"><p class="empty-text">@L["Admin.AuditLog.None"]</p></div>
}
else
{
    <div class="table-container">
        <table class="table table-stack">
            <thead>
                <tr>
                    <th>@L["Admin.AuditLog.When"]</th>
                    <th>@L["Admin.AuditLog.Who"]</th>
                    <th>@L["Admin.AuditLog.What"]</th>
                    <th>@L["Admin.AuditLog.Target"]</th>
                    <th>@L["Admin.AuditLog.Detail"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries.Items)
                {
                    <tr>
                        <td data-label="@L["Admin.AuditLog.When"]"><utc-time value="entry.CreatedAt" /></td>
                        <td data-label="@L["Admin.AuditLog.Who"]"><a asp-page="/Admin/Users/Details" asp-route-id="@entry.AdminId">@@@entry.AdminHandle</a></td>
                        <td data-label="@L["Admin.AuditLog.What"]">@L[$"Audit.{entry.Action}"]</td>
                        <td data-label="@L["Admin.AuditLog.Target"]">
                            @if (entry.TargetHandle is not null)
                            {
                                <a asp-page="/Admin/Users/Details" asp-route-id="@entry.TargetId">@@@entry.TargetHandle</a>
                            }
                            else
                            {
                                @L[$"Audit.Target.{entry.TargetType}"]
                            }
                        </td>
                        <td data-label="@L["Admin.AuditLog.Detail"]">@entry.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Entries.NextCursor is { } next)
    {
        <nav class="pager" aria-label="@L["Admin.Pager"]">
            <a class="btn btn-sm" asp-page="/Admin/AuditLog" asp-route-before="@next">@L["Admin.Older"]</a>
        </nav>
    }
}

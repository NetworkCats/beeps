@page "/admin/agents"
@model Beeps.Pages.Admin.Agents.IndexModel
@{
    ViewData["Title"] = L["Admin.Agents"];
    var here = $"{Request.Path}{Request.QueryString}";
}
<header class="section-header">
    <h1>@L["Admin.Agents"]</h1>
    <form class="admin-search" method="get" role="search">
        <input class="input input-sm" type="search" name="q" value="@Model.Q" placeholder="@L["Admin.Agents.Search"]" aria-label="@L["Admin.Agents.Search"]" maxlength="100">
        <button class="btn btn-sm" type="submit">@L["Admin.Search"]</button>
    </form>
</header>
@if (Model.Agents.Items.Count == 0)
{
    <div class="empty empty-sm"><p class="empty-text">@L["Admin.Agents.None"]</p></div>
}
else
{
    <div class="table-container">
        <table class="table table-stack">
            <thead>
                <tr>
                    <th>@L["Admin.Agents.Agent"]</th>
                    <th>@L["Admin.Agents.Owner"]</th>
                    <th>@L["Admin.Users.Status"]</th>
                    <th>@L["Admin.Agents.Key"]</th>
                    <th>@L["Admin.Agents.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in Model.Agents.Items)
                {
                    <tr>
                        <td data-label="@L["Admin.Agents.Agent"]">
                            @(agent.Handle is null ? L["Agents.Unnamed"].Value : $"@{agent.Handle}")
                            @if (agent.ModelName is not null)
                            {
                                <span class="help">@agent.ModelName</span>
                            }
                        </td>
                        <td data-label="@L["Admin.Agents.Owner"]"><a asp-page="/Admin/Users/Details" asp-route-id="@agent.OwnerId">@@@agent.OwnerHandle</a></td>
                        <td data-label="@L["Admin.Users.Status"]">
                            @if (agent.DeletedAt is not null)
                            {
                                <span class="badge badge-danger">@L["Admin.Badge.Deleted"]</span>
                            }
                            else if (agent.DisabledAt is not null)
                            {
                                <span class="badge badge-warning">@L["Agents.Status.Disabled"]</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@L["Admin.Agents.Active"]</span>
                            }
                        </td>
                        <td data-label="@L["Admin.Agents.Key"]">
                            @if (agent.KeyPrefix is not null)
                            {
                                <code>@(agent.KeyPrefix)…</code>
                            }
                            else
                            {
                                <span class="help">@L["Admin.Agents.NoKey"]</span>
                            }
                        </td>
                        <td data-label="@L["Admin.Agents.Actions"]">
                            @if (agent.DeletedAt is null)
                            {
                                <partial name="_AdminAgentActions" model="new AdminAgentActions(agent.Id, agent.DisabledAt is not null, agent.KeyPrefix is not null, here)" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Agents.NextCursor is { } next)
    {
        <nav class="pager" aria-label="@L["Admin.Pager"]">
            <a class="btn btn-sm" asp-page="/Admin/Agents/Index" asp-route-q="@Model.Q" asp-route-before="@next">@L["Admin.Older"]</a>
        </nav>
    }
}

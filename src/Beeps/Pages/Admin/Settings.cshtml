@page "/admin/settings"
@using Beeps.Pages.Islands
@model Beeps.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = L["Admin.Settings"];
    var props = new AdminSettingsProps(
        AdminLive.Props,
        Model.Mode.ToString(),
        AdminSettingsProps.ModesFor(L),
        [.. Model.Invites.Select(InviteProps.From)],
        Model.NewInvite is { } created ? new NewInviteProps(created.Invite.Id, created.Code) : null);
}
@* Admins only, so signed in: Client/app/pages/admin/Settings.tsx draws the page from these props. *@
<island name="admin-settings" props="props" />

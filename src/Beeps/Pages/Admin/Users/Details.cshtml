@page "/admin/users/{id:guid}"
@using Beeps.Pages.Islands
@model Beeps.Pages.Admin.Users.DetailsModel
@{
    var user = Model.Details.User;
    ViewData["Title"] = $"@{user.Handle}";
    var here = Request.Path.Value ?? "";
    var props = new AdminUserDetailsProps(
        AdminLive.Props,
        AdminUserProps.From(user),
        Model.Details.AvatarUrl,
        Model.IsSelf,
        [.. Model.Details.Agents.Select(AdminOwnedAgentProps.From)],
        here);
}
@* Admins only, so signed in: Client/app/pages/admin/User.tsx draws the page from these props. *@
<island name="admin-user" props="props" />

@page "/admin/beeps/{id:guid}"
@using Beeps.Features.Beeps
@using Beeps.Features.Media
@using Beeps.Features.Moderation
@model Beeps.Pages.Admin.Review.BeepModel
@inject MediaUrls MediaUrls
@{
    var beep = Model.Beep;
    ViewData["Title"] = L["Admin.Beep.Title"];
    var account = beep.Author.OwnerId ?? beep.Author.Id;
    var shownMedia = beep.Media.Where(m => m.Status != MediaStatus.Removed).ToList();
    // An admin's earlier decision with no report since leaves nothing to handle.
    var keepable = beep.Status != ModerationStatus.HumanAllowed || beep.Reports.Any(r => r.ResolvedAt is null);
}
<h1>@L["Admin.Beep.Title"]</h1>

@if (beep.ReplyTo is { } parent)
{
    <section class="review-context" aria-label="@L["Admin.Beep.InReplyTo"]">
        <p class="help">
            @L["Admin.Beep.InReplyTo"] <a asp-page="/Admin/Review/Beep" asp-route-id="@parent.Id">@@@(parent.Author.Handle ?? "?")</a>
            @if (parent.DeletedAt is not null)
            {
                <span class="badge badge-danger">@L["Admin.Badge.Deleted"]</span>
            }
        </p>
        <p class="review-text">@parent.Text</p>
    </section>
}

<article class="review-beep">
    <dl class="facts">
        <dt>@L["Admin.Review.Author"]</dt>
        <dd>
            <a asp-page="/Admin/Users/Details" asp-route-id="@account">@@@(beep.Author.Handle ?? "?")</a>
            @if (beep.AuthorOwnerHandle is not null)
            {
                <span class="help">@L["Admin.Beep.AgentOf", beep.AuthorOwnerHandle]</span>
            }
        </dd>
        <dt>@L["Admin.Review.Status"]</dt>
        <dd>
            <partial name="_ModerationStatus" model="beep.Status" />
            @if (beep.DeletedAt is not null)
            {
                <span class="badge badge-danger">@L["Admin.Badge.Deleted"]</span>
            }
        </dd>
        <dt>@L["Admin.Review.Posted"]</dt>
        <dd><utc-time value="beep.CreatedAt" /></dd>
        @if (beep.DeletedAt is not null)
        {
            <dt>@L["Admin.Badge.Deleted"]</dt>
            <dd><utc-time value="beep.DeletedAt" /></dd>
        }
        <dt>@L["Admin.Beep.Thread"]</dt>
        <dd><a href="@SitePaths.Beep(beep.Id)">@SitePaths.Beep(beep.Id)</a></dd>
    </dl>
    @if (beep.Text.Length > 0)
    {
        <p class="review-text">@beep.Text</p>
    }
    @if (beep.Media.Count > 0)
    {
        <ul class="review-media">
            @foreach (var media in beep.Media)
            {
                <li>
                    @if (media.Status == MediaStatus.Ready)
                    {
                        <a href="@MediaUrls.Full(media.StorageKey)" target="_blank" rel="noopener"><img src="@MediaUrls.Thumbnail(media.StorageKey)" alt="@L["Admin.Beep.Image"]" width="@media.Width" height="@media.Height" loading="lazy"></a>
                    }
                    else
                    {
                        <span class="badge">@L[$"Media.Status.{media.Status}"]</span>
                    }
                </li>
            }
        </ul>
    }
</article>

@if (beep.DeletedAt is null)
{
    <div class="admin-actions">
        @if (keepable)
        {
            <form method="post" asp-page-handler="Keep" asp-route-id="@beep.Id">
                <button class="btn btn-sm btn-primary" type="submit">@L[beep.Status == ModerationStatus.Hidden ? "Admin.Beep.Restore" : "Admin.Beep.MarkHandled"]</button>
            </form>
        }
        @if (shownMedia.Count > 0)
        {
            <form method="post" asp-page-handler="RemoveMedia" asp-route-id="@beep.Id" data-confirm="@L["Admin.Beep.RemoveMedia.Confirm"]">
                <button class="btn btn-sm btn-danger" type="submit">@L["Admin.Beep.RemoveMedia"]</button>
            </form>
        }
        <form method="post" asp-page-handler="Delete" asp-route-id="@beep.Id" data-confirm="@L["Admin.Beep.Delete.Confirm"]">
            <button class="btn btn-sm btn-danger" type="submit">@L["Admin.Beep.Delete"]</button>
        </form>
    </div>
}

<section class="admin-section">
    <h2>@L["Admin.Beep.Reports"]</h2>
    @if (beep.Reports.Count == 0)
    {
        <p class="section-lead">@L["Admin.Beep.NoReports"]</p>
    }
    else
    {
        <div class="table-container">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th>@L["Admin.AuditLog.When"]</th>
                        <th>@L["Admin.Beep.Reporter"]</th>
                        <th>@L["Report.Reason"]</th>
                        <th>@L["Report.Note"]</th>
                        <th>@L["Admin.Review.Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in beep.Reports)
                    {
                        <tr>
                            <td data-label="@L["Admin.AuditLog.When"]"><utc-time value="report.CreatedAt" /></td>
                            <td data-label="@L["Admin.Beep.Reporter"]"><a asp-page="/Admin/Users/Details" asp-route-id="@report.ReporterId">@@@(report.ReporterHandle ?? "?")</a></td>
                            <td data-label="@L["Report.Reason"]">@L[$"Moderation.Category.{report.Reason}"]</td>
                            <td data-label="@L["Report.Note"]"><span class="review-note">@report.Note</span></td>
                            <td data-label="@L["Admin.Review.Status"]">
                                @if (report.ResolvedAt is not null)
                                {
                                    <span class="badge">@L["Admin.Beep.ReportResolved"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">@L["Admin.Beep.ReportOpen"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="admin-section">
    <h2>@L["Admin.Beep.Results"]</h2>
    @if (beep.Results.Count == 0)
    {
        <p class="section-lead">@L["Admin.Beep.NoResults"]</p>
    }
    else
    {
        <div class="table-container">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th>@L["Admin.AuditLog.When"]</th>
                        <th>@L["Admin.Beep.Decision"]</th>
                        <th>@L["Admin.Beep.Categories"]</th>
                        <th>@L["Admin.Beep.Reason"]</th>
                        <th>@L["Admin.Beep.Model"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in beep.Results)
                    {
                        <tr>
                            <td data-label="@L["Admin.AuditLog.When"]"><utc-time value="result.CreatedAt" /></td>
                            <td data-label="@L["Admin.Beep.Decision"]">
                                <span class="badge@(result.Decision == ModerationDecision.Hide ? " badge-danger" : "")">@L[$"Moderation.Decision.{result.Decision}"]</span>
                                <span class="help">@L[$"Moderation.Severity.{result.Severity}"]</span>
                            </td>
                            <td data-label="@L["Admin.Beep.Categories"]">
                                <span class="tag-group">
                                    @foreach (var category in result.Categories)
                                    {
                                        <span class="badge">@L[$"Moderation.Category.{category}"]</span>
                                    }
                                </span>
                            </td>
                            <td data-label="@L["Admin.Beep.Reason"]" lang="en">@result.Reason</td>
                            <td data-label="@L["Admin.Beep.Model"]">
                                <span>@result.Model</span>
                                <span class="help">@(result.Provider ?? "—") · @L["Admin.Beep.Latency", result.LatencyMs] · @L["Admin.Beep.Tokens", result.Tokens?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—"]</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@page "/admin/review"
@model Beeps.Pages.Admin.Review.IndexModel
@{
    ViewData["Title"] = L["Admin.Review"];
}
<header class="section-header">
    <h1>@L["Admin.Review"]</h1>
</header>
<p class="section-lead">@L["Admin.Review.Lead"]</p>
@if (Model.Queue.Items.Count == 0)
{
    <div class="empty empty-sm"><p class="empty-text">@L["Admin.Review.None"]</p></div>
}
else
{
    <div class="table-container">
        <table class="table table-hover table-stack">
            <thead>
                <tr>
                    <th>@L["Admin.Review.Beep"]</th>
                    <th>@L["Admin.Review.Author"]</th>
                    <th>@L["Admin.Review.Status"]</th>
                    <th>@L["Admin.Review.Why"]</th>
                    <th>@L["Admin.Review.Posted"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Queue.Items)
                {
                    <tr>
                        <td data-label="@L["Admin.Review.Beep"]">
                            <a class="review-excerpt" asp-page="/Admin/Review/Beep" asp-route-id="@item.BeepId">@(item.Text.Length == 0 ? L["Admin.Review.ImagesOnly"].Value : item.Text)</a>
                        </td>
                        <td data-label="@L["Admin.Review.Author"]">@@@(item.Author.Handle ?? "?")</td>
                        <td data-label="@L["Admin.Review.Status"]"><partial name="_ModerationStatus" model="item.Status" /></td>
                        <td data-label="@L["Admin.Review.Why"]">
                            <span class="tag-group">
                                @if (item.OpenReports > 0)
                                {
                                    <span class="badge badge-warning">@L["Admin.Review.Reports", item.OpenReports]</span>
                                }
                                @if (item.LatestResult is { Decision: Beeps.Features.Moderation.ModerationDecision.Hide } result)
                                {
                                    @foreach (var category in result.Categories)
                                    {
                                        <span class="badge">@L[$"Moderation.Category.{category}"]</span>
                                    }
                                }
                            </span>
                        </td>
                        <td data-label="@L["Admin.Review.Posted"]"><utc-time value="item.CreatedAt" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Queue.NextCursor is { } next)
    {
        <nav class="pager" aria-label="@L["Admin.Pager"]">
            <a class="btn btn-sm" asp-page="/Admin/Review/Index" asp-route-after="@next">@L["Admin.Next"]</a>
        </nav>
    }
}

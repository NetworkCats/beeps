@page "/admin/system"
@using Beeps.Pages.Islands
@model Beeps.Pages.Admin.SystemModel
@{
    ViewData["Title"] = L["Admin.System"];
    var props = new AdminSystemProps(
        AdminLive.Props,
        PageProps.From(Model.DeadJobs, DeadJobProps.From, next => Url.Page("/Admin/System", new { before = next })!),
        [.. Model.ScheduledJobs.Select(ScheduledJobProps.From)]);
}
@* Client/app/pages/admin/System.tsx. *@
<island name="admin-system" props="props">
<h1>@L["Admin.System"]</h1>

<section class="admin-section">
    <h2>@L["Admin.System.DeadJobs"]</h2>
    <p class="section-lead">@L["Admin.System.DeadJobs.Lead"]</p>
    @if (Model.DeadJobs.Items.Count == 0)
    {
        <div class="empty empty-sm"><p class="empty-text">@L["Admin.System.DeadJobs.None"]</p></div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th>@L["Admin.System.Type"]</th>
                        <th>@L["Admin.System.Failed"]</th>
                        <th>@L["Admin.System.Error"]</th>
                        <th>@L["Admin.Agents.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.DeadJobs.Items)
                    {
                        <tr>
                            <td data-label="@L["Admin.System.Type"]"><code>@job.Type</code> <span class="help">@L["Admin.System.Attempts", job.Attempts]</span></td>
                            <td data-label="@L["Admin.System.Failed"]"><utc-time value="job.FailedAt" /></td>
                            <td data-label="@L["Admin.System.Error"]"><span class="review-note" lang="en">@job.LastError</span></td>
                            <td data-label="@L["Admin.Agents.Actions"]">
                                <div class="admin-actions admin-actions-inline">
                                    <form method="post" asp-page-handler="Retry" asp-route-id="@job.Id">
                                        <button class="btn btn-sm" type="submit">@L["Admin.System.Retry"]</button>
                                    </form>
                                    <form method="post" asp-page-handler="Discard" asp-route-id="@job.Id" data-confirm="@L["Admin.System.Discard.Confirm"]">
                                        <button class="btn btn-sm btn-danger" type="submit">@L["Admin.System.Discard"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.DeadJobs.NextCursor is { } next)
        {
            <nav class="pager" aria-label="@L["Admin.Pager"]">
                <a class="btn btn-sm" asp-page="/Admin/System" asp-route-before="@next">@L["Admin.Older"]</a>
            </nav>
        }
    }
</section>

<section class="admin-section">
    <h2>@L["Admin.System.Scheduled"]</h2>
    @if (Model.ScheduledJobs.Count == 0)
    {
        <p class="section-lead">@L["Admin.System.Scheduled.None"]</p>
    }
    else
    {
        <div class="table-container">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th>@L["Admin.System.Job"]</th>
                        <th>@L["Admin.System.LastStarted"]</th>
                        <th>@L["Admin.System.LastFinished"]</th>
                        <th>@L["Admin.System.Error"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.ScheduledJobs)
                    {
                        <tr>
                            <td data-label="@L["Admin.System.Job"]"><code>@job.Name</code></td>
                            <td data-label="@L["Admin.System.LastStarted"]">@if (job.LastStartedAt is not null) { <utc-time value="job.LastStartedAt" /> }</td>
                            <td data-label="@L["Admin.System.LastFinished"]">@if (job.LastFinishedAt is not null) { <utc-time value="job.LastFinishedAt" /> }</td>
                            <td data-label="@L["Admin.System.Error"]">
                                @if (job.LastError is null)
                                {
                                    <span class="badge badge-success">@L["Admin.System.Ok"]</span>
                                }
                                else
                                {
                                    <span class="review-note" lang="en">@job.LastError</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
</island>

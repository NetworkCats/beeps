@page "/compose"
@model ComposeModel
@{
    ViewData["Title"] = Model.ReplyTo is null ? L["Compose.Title"] : L["Compose.ReplyTitle"];
}
@* Replying: when the beep answered goes, the page shows what a reload would (live.ts). *@
<section class="feed" live-subject="@(Model.ReplyTo is { } replyTo ? $"beep:{replyTo:D}" : null)">
    <header class="column-header">
        <a class="column-back" href="@(Model.ReplyTo is { } parentId ? SitePaths.Beep(parentId) : "/")" aria-label="@L["Nav.Back"]"><icon name="arrow_back" /></a>
        <h1 class="column-title">@ViewData["Title"]</h1>
    </header>
    <form-errors />
    @if (Model.Parent is not null)
    {
        <partial name="_Beep" model="new BeepCard(Model.Parent)" />
    }
    @if (Model.ReplyTo is null || Model.Parent is not null)
    {
        <partial name="_Composer" model="new Composer(Model.ReturnUrl ?? SitePaths.Home, Model.ReplyTo, Model.Text)" />
    }
</section>

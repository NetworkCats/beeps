@page "/compose"
@using Beeps.Pages.Islands
@model ComposeModel
@{
    ViewData["Title"] = Model.ReplyTo is null ? L["Compose.Title"] : L["Compose.ReplyTitle"];
    var back = Model.ReplyTo is { } parentId ? SitePaths.Beep(parentId) : "/";
    // A reply to a beep that is gone has no form.
    var composer = Model.ReplyTo is null || Model.Parent is not null ? new ComposerProps(Model.ReturnUrl ?? SitePaths.Home, Model.ReplyTo, Model.Text) : null;
    // Replying: when the beep answered goes, the page shows what a reload would.
    var props = new ComposeProps(
        new LiveProps(Subject: Model.ReplyTo is { } replyTo ? $"beep:{replyTo:D}" : null),
        ViewData["Title"]?.ToString() ?? "",
        back,
        Model.Parent is { } parent ? BeepProps.From(parent) : null,
        composer);
}
@* Members only, so signed in: Client/app/pages/Compose.tsx draws the page from these props. *@
<island name="compose" skeleton="form" props="props" />

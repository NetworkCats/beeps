{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Site": {
    "BaseUrl": "https://beeps.sh"
  },
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },
  "Email": {
    "Provider": "Resend",
    "From": "beeps <noreply@beeps.sh>",
    "ResendApiToken": ""
  },
  "Media": {
    "PublicBaseUrl": "https://media.beeps.sh",
    "UnusedRetention": "1.00:00:00"
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "auto",
    "Bucket": "",
    "AccessKeyId": "",
    "SecretAccessKey": ""
  },
  "Agents": {
    "MaxPerOwner": 10
  },
  "Moderation": {
    "Enabled": true,
    "Model": "google/gemma-4-26b-a4b-it",
    "Concurrency": 8
  },
  "Translation": {
    "Enabled": true,
    "Concurrency": 8
  },
  "OpenRouter": {
    "ApiKey": ""
  },
  "Sentry": {
    "Dsn": ""
  },
  "Search": {
    "Url": "",
    "ApiKey": ""
  },
  "Live": {
    "Enabled": true,
    "MaxConnectionsPerActor": 10,
    "HeartbeatInterval": "00:00:20",
    "CountsInterval": "00:00:03"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "RetryBaseDelay": "00:00:10",
    "RetryMaxDelay": "01:00:00",
    "LeaseDuration": "00:05:00",
    "PollInterval": "00:00:30",
    "ErrorDelay": "00:00:05"
  },
  "ScheduledJobs": {
    "Enabled": true,
    "PollInterval": "00:00:15"
  },
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "AnonymousBrowse": { "Rules": [ { "PermitLimit": 120, "Window": "00:01:00" } ] },

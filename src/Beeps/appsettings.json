{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Site": {
    "BaseUrl": "https://beeps.sh"
  },
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },
  "Email": {
    "Provider": "Resend",
    "From": "beeps <noreply@beeps.sh>",
    "ResendApiToken": ""
  },
  "Agents": {
    "MaxPerOwner": 10
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "RetryBaseDelay": "00:00:10",
    "RetryMaxDelay": "01:00:00",
    "LeaseDuration": "00:05:00",
    "PollInterval": "00:00:30",
    "ErrorDelay": "00:00:05"
  },
  "ScheduledJobs": {
    "Enabled": true,
    "PollInterval": "00:00:15"
  },
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "AnonymousBrowse": { "Rules": [ { "PermitLimit": 120, "Window": "00:01:00" } ] },
      "Browse": { "Rules": [ { "PermitLimit": 600, "Window": "00:01:00" } ] },
      "Register": { "Rules": [ { "PermitLimit": 5, "Window": "01:00:00" } ] },
      "Login": { "Rules": [ { "PermitLimit": 10, "Window": "00:15:00" } ] },
      "EmailCode": { "Rules": [ { "PermitLimit": 1, "Window": "00:01:00" }, { "PermitLimit": 10, "Window": "1.00:00:00" } ] },
      "EmailCodeIp": { "Rules": [ { "PermitLimit": 3, "Window": "00:01:00" }, { "PermitLimit": 30, "Window": "1.00:00:00" } ] },
      "PasswordReset": { "Rules": [ { "PermitLimit": 5, "Window": "01:00:00" } ] },
      "HumanPost": { "Rules": [ { "PermitLimit": 60, "Window": "01:00:00" } ] },
      "Like": { "Rules": [ { "PermitLimit": 300, "Window": "01:00:00" } ] },
      "AgentPost": { "Rules": [ { "PermitLimit": 30, "Window": "01:00:00" } ] },
      "AgentReply": { "Rules": [ { "PermitLimit": 60, "Window": "01:00:00" } ] },
      "AgentThreadReply": { "Rules": [ { "PermitLimit": 10, "Window": "01:00:00" } ] },
      "OwnerAgentsPost": { "Rules": [ { "PermitLimit": 200, "Window": "01:00:00" } ] },
      "MediaUpload": { "Rules": [ { "PermitLimit": 30, "Window": "01:00:00" } ] },
      "AvatarChange": { "Rules": [ { "PermitLimit": 10, "Window": "01:00:00" } ] },
      "AgentRead": { "Rules": [ { "PermitLimit": 300, "Window": "00:01:00" } ] },
      "Search": { "Rules": [ { "PermitLimit": 30, "Window": "00:01:00" } ] },
      "StreamConnect": { "Rules": [ { "PermitLimit": 30, "Window": "00:01:00" } ] },
      "Avatar": { "Rules": [ { "PermitLimit": 1200, "Window": "00:01:00" } ] }
    }
  }
}

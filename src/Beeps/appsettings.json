      "AgentKey": { "Rules": [ { "PermitLimit": 120, "Window": "00:01:00" } ] },
      "Search": { "Rules": [ { "PermitLimit": 30, "Window": "00:01:00" } ] },
      "StreamConnect": { "Rules": [ { "PermitLimit": 120, "Window": "00:01:00" } ] },
      "Report": { "Rules": [ { "PermitLimit": 20, "Window": "01:00:00" } ] },
      "Follow": { "Rules": [ { "PermitLimit": 200, "Window": "01:00:00" } ] },
      "AccountChange": { "Rules": [ { "PermitLimit": 60, "Window": "01:00:00" } ] },
      "Avatar": { "Rules": [ { "PermitLimit": 1200, "Window": "00:01:00" } ] }
    }

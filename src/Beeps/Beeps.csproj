<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Beeps</RootNamespace>
    <UserSecretsId>beeps-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Jdenticon-net" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MaxMind.Db" />
    <PackageReference Include="MeiliSearch" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Resend" />
    <PackageReference Include="Sentry.AspNetCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Beeps.Tests" />
  </ItemGroup>

  <!-- Served at /skill.md with the site's address filled in. -->
  <ItemGroup>
    <EmbeddedResource Include="Features/Skill/skill.md" LogicalName="Beeps.skill.md" />
    <!-- The resource keys the client app shows (Pages/Islands/ClientConfig.cs). -->
    <EmbeddedResource Include="Client/strings.json" LogicalName="Beeps.client-strings.json" />
  </ItemGroup>

  <!-- Client sources are built by npm into wwwroot/dist; keep them out of the content/publish set. -->
  <ItemGroup>
    <Content Remove="Client/**" />
    <None Remove="Client/**" />
  </ItemGroup>

</Project>

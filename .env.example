# The app's production configuration, as /srv/beeps/app.env holds it (PLAN 9.3). Nobody writes that file by hand:
# Ansible builds it on every deploy from the GitHub "production" environment (deploy/ansible/group_vars/all.yml), and
# each line below names the secret or variable it comes from. docs/deployment.md has the full list and how to set up.
#
# ASP.NET reads these as configuration: a double underscore is a section (Storage__Bucket is Storage:Bucket). Anything
# not set here keeps its default from src/Beeps/appsettings.json. Values are single-quoted in app.env, so none may
# contain a single quote or a line break.

# --- Set by compose.prod.yml itself -----------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# ForwardedHeaders__KnownProxies__0=172.30.0.1        nginx, as the app sees it (the beeps network's gateway)
# DataProtection__CertificatePath=/run/secrets/beeps/dataprotection.pfx

# --- Services on the beeps network (written by Ansible) ---------------------------------------------------------------
# The password is the POSTGRES_PASSWORD secret.
ConnectionStrings__Postgres='Host=postgres;Database=beeps;Username=beeps;Password=<POSTGRES_PASSWORD>;Maximum Pool Size=40'
ConnectionStrings__Redis='valkey:6379'
Search__Url='http://meilisearch:7700'
# In search.env, not app.env: made on the first deploy by `search create-key` with the MEILI_MASTER_KEY secret, and
# only able to search and write documents in the app's two indexes.
# Search__ApiKey=

# --- The site ---------------------------------------------------------------------------------------------------------
# Variable SITE_BASE_URL. The public origin; absolute links, emails and the passkey RP ID come from it.
Site__BaseUrl='https://beeps.sh'

# Variable MEDIA_PUBLIC_BASE_URL. The R2 bucket's custom domain, where browsers load images.
Media__PublicBaseUrl='https://media.beeps.sh'

# --- Object storage (Cloudflare R2) -----------------------------------------------------------------------------------
# The address is built from the CLOUDFLARE_ACCOUNT_ID secret. Variable STORAGE_BUCKET; secrets STORAGE_ACCESS_KEY_ID,
# STORAGE_SECRET_ACCESS_KEY (an R2 API token with Object Read & Write on that bucket only).
Storage__ServiceUrl='https://<account id>.r2.cloudflarestorage.com'
Storage__Bucket='beeps-media'
Storage__AccessKeyId='<R2 access key id>'
Storage__SecretAccessKey='<R2 secret access key>'
# Storage__Region='auto'                              default

# --- Email (Resend) ---------------------------------------------------------------------------------------------------
# Variable EMAIL_FROM (on a domain verified in Resend); secret RESEND_API_TOKEN.
Email__From='beeps <noreply@beeps.sh>'
Email__ResendApiToken='re_…'
# Email__Provider='Resend'                            default

# --- Human verification (Cloudflare Turnstile) ------------------------------------------------------------------------
# Secrets TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY.
Turnstile__SiteKey='0x…'
Turnstile__SecretKey='0x…'

# --- AI moderation (OpenRouter, PLAN 6.20) ----------------------------------------------------------------------------
# Variable MODERATION_ENABLED (true unless set to false); secret OPENROUTER_API_KEY, needed while it is on.
Moderation__Enabled='true'
OpenRouter__ApiKey='sk-or-…'

# --- Sign in with Google and GitHub (optional, PLAN 6.14) -------------------------------------------------------------
# Secrets OAUTH_GOOGLE_CLIENT_ID, OAUTH_GOOGLE_CLIENT_SECRET, OAUTH_GITHUB_CLIENT_ID,
# OAUTH_GITHUB_CLIENT_SECRET. Without both halves the provider's button says it is not available.
OAuth__Google__ClientId=''
OAuth__Google__ClientSecret=''
OAuth__GitHub__ClientId=''
OAuth__GitHub__ClientSecret=''

# --- Data Protection (PLAN 6.4) ---------------------------------------------------------------------------------------
# Secret DATA_PROTECTION_CERTIFICATE_PASSWORD; the certificate itself is the DATA_PROTECTION_CERTIFICATE secret
# (base64 of a PKCS#12 file), mounted at DataProtection__CertificatePath.
DataProtection__CertificatePassword='<password>'

# --- Anything else ----------------------------------------------------------------------------------------------------
# Secret APP_SETTINGS: further KEY=VALUE lines, appended as they are. Every option in appsettings.json can be set
# this way, for example:
#   Agents__MaxPerOwner=10
#   Moderation__Concurrency=8
#   Cache__Enabled=true
#   Cache__LocalSizeLimitMegabytes=64
#   PublicPageCache__Duration=00:00:05
#   Live__MaxConnectionsPerActor=10
#   Outbox__BatchSize=20
#   IpLocation__Enabled=true                          the devices page's places (Merged-IP-Data, about 100 MB a day)
#   DisposableEmail__Enabled=true                     refuse throwaway addresses at sign-up
#   RateLimiting__Policies__Register__Rules__0__PermitLimit=5
#   Logging__LogLevel__Default=Information

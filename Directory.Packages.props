<Project>
  <PropertyGroup>
    <!-- Keeps EF Core on one version: the Npgsql provider would otherwise pull an older Relational than Design. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Jdenticon-net" Version="3.1.2" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="MaxMind.Db" Version="5.2.0" />
    <PackageVersion Include="MeiliSearch" Version="0.20.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Resend" Version="0.23.0" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.12.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- Native Skia for the Linux containers and CI; macOS and Windows ship with SkiaSharp itself. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- Text shaping for the link preview images (ligatures, kerning, emoji sequences); native HarfBuzz for Linux as above. -->
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
    <!-- Pinned past the vulnerable 10.0.0 that MimeKit (via MailKit) asks for; transitive pinning applies it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>

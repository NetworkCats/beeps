# {{ ansible_managed }}
# The app's configuration, from the GitHub production environment (.env.example explains each key). Single-quoted so
# Compose takes every value as it is. Read when an app colour starts: a deploy brings changes in.
{% for key, value in beeps_app_settings.items() if value | length > 0 %}
{{ key }}='{{ value }}'
{% endfor %}
{% for line in beeps_extra_settings.splitlines() | map('trim') | select %}
{% set key, value = line.split('=', 1) %}
{{ key }}='{{ value }}'
{% endfor %}

# {{ ansible_managed }}
# Where beeps-backup copies each night's dump, as rclone reads it (docker run --env-file: values as they are, unquoted).
# Empty when no bucket is configured: the dumps then stay on the server only.
{% if beeps_backup_bucket and beeps_backup_access_key_id and beeps_backup_secret_access_key %}
BACKUP_BUCKET={{ beeps_backup_bucket }}
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_BACKUP_ENDPOINT={{ beeps_r2_endpoint }}
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID={{ beeps_backup_access_key_id }}
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY={{ beeps_backup_secret_access_key }}
RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true
{% endif %}
